<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Compare Deals</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body { background-color: #f8f9fa; font-family: 'Poppins', sans-serif; }
    .deal-card {
      border: 1px solid #ddd;
      border-radius: 10px;
      padding: 15px;
      background-color: white;
      text-align: center;
    }
    .deal-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 10px;
    }
  </style>
</head>
<body>

  <div class="container mt-5">
    <h2 class="text-center mb-4">Compare Selected Deals</h2>
    <% if (deals.length > 0) { %>
      <div class="row">
        <% deals.forEach((deal) => { %>
          <div class="col-md-4 mb-4">
            <div class="deal-card">
              <img src="<%= deal.image %>" class="deal-img" alt="<%= deal.title %>">
              <h5 class="mt-3"><%= deal.title %></h5>
              <p><%= deal.description %></p>
              <h6>Price: ₹<%= deal.price %></h6>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-center">No deals selected for comparison.</p>
    <% } %>

    <div class="text-center mt-4">
      <a href="/" class="btn btn-secondary">Back to Deals</a>
    </div>
  </div>

</body>
</html>
