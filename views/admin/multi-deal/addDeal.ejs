<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Multi-Deal</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #e3f2fd, #ffffff);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }

    .form-container {
      background: white;
      border-radius: 20px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      padding: 40px 35px;
      width: 100%;
      max-width: 650px;
      animation: fadeIn 0.6s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    h2 {
      text-align: center;
      font-weight: 700;
      color: #0d47a1;
      margin-bottom: 25px;
    }

    label.form-label {
      font-weight: 600;
      color: #1565c0;
    }

    .form-control {
      border-radius: 10px;
      padding: 10px 14px;
      border: 1px solid #bbdefb;
      margin-bottom: 15px;
      transition: all 0.2s ease-in-out;
    }

    .form-control:focus {
      border-color: #2196f3;
      box-shadow: 0 0 0 0.2rem rgba(33,150,243,0.25);
    }

    textarea {
      resize: none;
      height: 100px;
    }

    .checkbox-group {
      margin-bottom: 20px;
      display: flex;
      justify-content: space-around;
    }

    .checkbox-group label {
      color: #333;
      font-weight: 500;
      cursor: pointer;
    }

    .btn-submit {
      background: linear-gradient(90deg, #2196f3, #64b5f6);
      border: none;
      border-radius: 12px;
      color: white;
      padding: 12px;
      font-weight: 600;
      width: 100%;
      transition: all 0.3s ease;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 18px rgba(33,150,243,0.3);
    }

    .fade-section {
      display: none;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .fade-section.show {
      display: block;
      opacity: 1;
    }

    .required::after {
      content: " *";
      color: red;
    }
  </style>
</head>
<body>

  <div class="form-container">
    <h2>Add Multi-Deal</h2>

    <form action="/admin/multi-deals/add-multi-deal" method="POST" id="dealForm">

      <!-- Collections -->
      <div class="checkbox-group">
        <label><input type="checkbox" name="collections" value="newdeal" onclick="toggleFields()"> NewDeal</label>
        <label><input type="checkbox" name="collections" value="deal" onclick="toggleFields()"> Deal</label>
        <label><input type="checkbox" name="collections" value="drop" onclick="toggleFields()"> Drop</label>
      </div>

      <!-- Common Fields -->
      <div>
        <label class="form-label required">Title</label>
        <input type="text" class="form-control" name="title" placeholder="Enter deal title" required>

        <label class="form-label">Description</label>
        <textarea class="form-control" name="description" placeholder="Enter description"></textarea>

        <label class="form-label required">Image URL</label>
        <input type="text" class="form-control" name="image" placeholder="https://example.com/image.jpg" required>

        <label class="form-label required">Price</label>
        <input type="number" class="form-control" name="price" placeholder="Enter price" required>
      </div>

      <!-- Deal/Drop Fields -->
      <div id="discountDiv" class="fade-section">
        <label class="form-label">Discount %</label>
        <input type="number" class="form-control" name="discount" placeholder="Optional discount">
      </div>

      <!-- Drop Fields -->
      <div id="timeDiv" class="fade-section">
        <label class="form-label">Start Time</label>
        <input type="datetime-local" class="form-control" name="startTime">
        <label class="form-label mt-2">End Time</label>
        <input type="datetime-local" class="form-control" name="endTime">
      </div>

      <!-- Featured Checkbox -->
      <div id="featuredDiv" class="fade-section form-check mt-3">
        <input type="checkbox" class="form-check-input" name="featured" value="true" id="featuredCheckbox">
        <label class="form-check-label" for="featuredCheckbox">Mark as Featured</label>
      </div>

      <button type="submit" class="btn-submit mt-4">Submit Deal</button>
    </form>
  </div>

  <script>
    function toggleFields() {
      const selected = Array.from(document.querySelectorAll('input[name="collections"]:checked')).map(cb => cb.value);

      const discountDiv = document.getElementById('discountDiv');
      const timeDiv = document.getElementById('timeDiv');
      const featuredDiv = document.getElementById('featuredDiv');

      // Discount visible for Deal or Drop
      discountDiv.classList.toggle('show', selected.includes('deal') || selected.includes('drop'));

      // Start/End time visible for Drop
      timeDiv.classList.toggle('show', selected.includes('drop'));

      // Featured checkbox visible if any selected
      featuredDiv.classList.toggle('show', selected.length > 0);
    }
  </script>

</body>
</html>
