<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Earnings | BharatMart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body { font-family: 'Segoe UI', sans-serif; background: #f0f4f7; }
    #sidebar { position: fixed; left: 0; top: 0; width: 220px; height: 100vh; background: #1b5e20; padding-top: 60px; }
    #sidebar a { display: flex; align-items: center; gap: 12px; padding: 12px 20px; color: white; text-decoration: none; margin: 8px 10px; border-radius: 10px; }
    #sidebar a.active { background: rgba(255,255,255,0.2); }
    #main-content { margin-left: 240px; padding: 30px; }

    .card-stat { border: none; border-radius: 15px; padding: 20px; color: white; transition: 0.3s; }
    .bg-revenue { background: linear-gradient(135deg, #1e7d32, #2e7d32); }
    .bg-expense { background: linear-gradient(135deg, #d32f2f, #ef5350); }
    .bg-profit { background: linear-gradient(135deg, #0288d1, #03a9f4); }
  </style>
</head>
<body>

<div id="sidebar">
  <h4 class="text-center text-white mb-4">Admin</h4>
  <a href="/admin/dashboard"><i class="fas fa-home"></i> Dashboard</a>
  <a href="/admin/orders/earnings" class="active"><i class="fas fa-chart-line"></i> My Earnings</a>
  <a href="/admin/orders"><i class="fas fa-shopping-cart"></i> All Orders</a>
  <a href="/admin/transactions"><i class="fas fa-exchange-alt"></i> Audit Trail</a>
  <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
</div>

<div id="main-content">
  <h2 class="text-success fw-bold mb-4">Financial Dashboard (Admin)</h2>

  <div class="row g-4 mb-4">
    <!-- Order Commission -->
    <div class="col-md-3">
      <div class="card-stat bg-revenue shadow">
        <h6>Order Commission (10%)</h6>
        <h3>₹<%= stats.totalCommission.toFixed(0) %></h3>
        <small>From Sales</small>
      </div>
    </div>

    <!-- Slot Revenue -->
    <div class="col-md-3">
      <div class="card-stat bg-revenue shadow" style="background: linear-gradient(135deg, #6a1b9a, #8e24aa);">
        <h6>Slot Booking Fees</h6>
        <h3>₹<%= slotRevenue.toFixed(0) %></h3>
        <small>Drops & 24Hr Deals</small>
      </div>
    </div>

    <!-- Delivery Fees -->
    <div class="col-md-2">
      <div class="card-stat bg-revenue shadow">
        <h6>Delivery Fees</h6>
        <h3>₹<%= stats.totalDelivery.toFixed(0) %></h3>
        <small>Logistics Gross</small>
      </div>
    </div>

    <!-- Referral Expense -->
    <div class="col-md-2">
      <div class="card-stat bg-expense shadow">
        <h6>Referral Payouts</h6>
        <h3>₹<%= totalExpense %></h3>
        <small>Marketing Cost</small>
      </div>
    </div>

    <!-- Net Profit -->
    <div class="col-md-2">
      <div class="card-stat bg-profit shadow">
        <h6>Net Profit</h6>
        <h2 class="fw-bold">₹<%= netProfit.toFixed(0) %></h2>
        <small>Final Bachat</small>
      </div>
    </div>
  </div>

  <!-- Charts -->
  <div class="row">
    <div class="col-md-8">
      <div class="card border-0 shadow rounded-4 p-4">
        <h5>Monthly Revenue Growth</h5>
        <canvas id="earningChart" height="120"></canvas>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow rounded-4 p-4">
        <h5>Revenue Source Split</h5>
        <canvas id="splitChart"></canvas>
      </div>
    </div>
  </div>
</div>
<!-- Is script block ko replace karo -->
<script>
  document.addEventListener("DOMContentLoaded", async () => {
    try {
        const res = await fetch("/admin/orders/earnings/chart-data");
        const data = await res.json();
        
        if (!data.success) return console.error("Data fetch failed");

        const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];

        // 1. Line Chart (Monthly Revenue)
        new Chart(document.getElementById('earningChart'), {
          type: 'line',
          data: {
            labels: months,
            datasets: [{ 
              label: 'Total Revenue (₹)', 
              data: data.monthlyFinal, // 🔥 Backend se aaya hua 12 mahino ka data
              borderColor: '#1b5e20', 
              backgroundColor: 'rgba(27, 94, 32, 0.1)',
              tension: 0.4, 
              fill: true,
              borderWidth: 3,
              pointBackgroundColor: '#1b5e20'
            }]
          },
          options: {
            responsive: true,
            scales: {
              y: { beginAtZero: true, grid: { display: true, color: '#eee' } },
              x: { grid: { display: false } }
            }
          }
        });

        // 2. Pie Chart (Revenue Split)
        new Chart(document.getElementById('splitChart'), {
          type: 'doughnut',
          data: {
            labels: ['Commission', 'Slot Fees', 'Delivery'],
            datasets: [{
              // 🔥 EJS se aayi hui live values
              data: [
                <%= stats.totalCommission %>, 
                <%= slotRevenue %>, 
                <%= stats.totalDelivery %>
              ],
              backgroundColor: ['#2e7d32', '#6a1b9a', '#ffa000'],
              hoverOffset: 10,
              borderWidth: 0
            }]
          },
          options: {
            plugins: {
              legend: { position: 'bottom' }
            }
          }
        });
    } catch (error) {
        console.error("Chart Error:", error);
    }
  });
</script>

</body>
</html>