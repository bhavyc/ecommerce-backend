<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Master Orders - Multi-Vendor Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    body { font-family: 'Segoe UI', sans-serif; background: #f0f4f7; overflow-x: hidden; }
    #sidebar { position: fixed; left: 0; top: 0; width: 220px; height: 100vh; background: #1b5e20; padding-top: 60px; z-index: 1000; }
    #sidebar a { display: flex; align-items: center; gap: 12px; padding: 12px 20px; color: white; text-decoration: none; margin: 8px 10px; border-radius: 10px; transition: 0.3s; }
    #sidebar a:hover, #sidebar a.active { background: rgba(255,255,255,0.2); }
    #main-content { margin-left: 240px; padding: 30px; }
    
    .table-card { background: white; border-radius: 15px; padding: 25px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
    .table thead { background-color: #e8f5e9; color: #1b5e20; border-bottom: 2px solid #2e7d32; }
    
    /* Vendor Block Styling */
    .vendor-block { background: #fdfdfd; border: 1px solid #eee; border-radius: 10px; padding: 12px; margin-bottom: 8px; border-left: 5px solid #2e7d32; transition: 0.2s; }
    .vendor-block:hover { border-color: #2e7d32; background: #fff; }
    
    .st-badge { padding: 3px 10px; border-radius: 20px; font-size: 9px; font-weight: 800; text-transform: uppercase; }
    .st-pending { background: #fff3cd; color: #856404; }
    .st-shipped { background: #cfe2ff; color: #084298; }
    .st-delivered { background: #d1e7dd; color: #0f5132; }
    .st-cancelled { background: #f8d7da; color: #842029; }

    .btn-xs { padding: 2px 8px; font-size: 10px; font-weight: bold; }
    .proof-img { width: 40px; height: 40px; object-fit: cover; border-radius: 5px; cursor: pointer; border: 1px solid #ddd; }
    .pagination .page-link { color: #1b5e20; border-radius: 5px; margin: 0 2px; }
    .pagination .page-item.active .page-link { background: #1b5e20; border-color: #1b5e20; }
  </style>
</head>
<body>

<div id="sidebar">
  <h4 class="text-center text-white mb-4">Admin</h4>
  <a href="/admin/dashboard"><i class="fas fa-home"></i> Dashboard</a>
  <a href="/admin/orders" class="active"><i class="fas fa-shopping-cart"></i> All Orders</a>
  <a href="/admin/payouts"><i class="fas fa-money-bill-wave"></i> Payout Requests</a>
  <a href="/admin/sellers/master-list"><i class="fas fa-list-ol"></i> Master List</a>
  <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
</div>

<div id="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-success fw-bold">Multi-Vendor Management</h2>
    <button onclick="loadOrders(1)" class="btn btn-outline-success"><i class="fas fa-sync"></i> Refresh</button>
  </div>

  <!-- Filters -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
      <div class="row g-3">
        <div class="col-md-5">
          <input id="searchInput" type="text" class="form-control" placeholder="Search Customer, Email or ID..." onkeyup="if(event.key === 'Enter') applyFilters()">
        </div>
        <div class="col-md-2"><input id="fromDate" type="date" class="form-control"/></div>
        <div class="col-md-2"><input id="toDate" type="date" class="form-control"/></div>
        <div class="col-md-3 d-flex gap-2">
          <button class="btn btn-success w-100 fw-bold" onclick="applyFilters()">Apply</button>
          <button class="btn btn-light border" onclick="clearFilters()"><i class="fas fa-redo"></i></button>
        </div>
      </div>
    </div>
  </div>

  <div class="table-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th width="120">Order ID</th>
            <th width="180">Customer Details</th>
            <th>Seller Items & Status</th>
            <th width="150" class="text-center">Global Order</th>
          </tr>
        </thead>
        <tbody id="orderTableBody"></tbody>
      </table>
    </div>

    <!-- 🔥 PAGINATION RESTORED & IMPROVED -->
    <div class="pagination-wrapper d-flex justify-content-between align-items-center mt-4">
      <div id="paginationInfo" class="small text-muted font-monospace"></div>
      <nav><ul class="pagination pagination-sm mb-0" id="paginationButtons"></ul></nav>
    </div>
  </div>
</div>

<script>
  let currentPage = 1;
  document.addEventListener("DOMContentLoaded", () => loadOrders(1));

  function applyFilters() { currentPage = 1; loadOrders(1); }
  function clearFilters() {
    document.getElementById("fromDate").value = "";
    document.getElementById("toDate").value = "";
    document.getElementById("searchInput").value = "";
    loadOrders(1);
  }

  async function loadOrders(page) {
    currentPage = page;
    const from = document.getElementById("fromDate").value;
    const to = document.getElementById("toDate").value;
    const search = document.getElementById("searchInput").value;
    const tbody = document.getElementById("orderTableBody");

    try {
      tbody.innerHTML = `<tr><td colspan="4" class="text-center py-5"><div class="spinner-border text-success"></div></td></tr>`;
      const params = new URLSearchParams({ page, limit: 10, from, to, search });
      const res = await fetch(`/admin/orders/data?${params.toString()}`);
      const data = await res.json();

      tbody.innerHTML = "";
      if (data.success && data.orders.length > 0) {
        data.orders.forEach(order => {
          // --- Multi-Vendor Logic: Group by Seller ---
          const vendors = {};
          order.items.forEach(item => {
            const sellerId = item.seller?._id || item.seller;
            const sellerName = item.seller?.businessName || item.seller?.name || `Seller ID: ${sellerId.toString().slice(-6)}`;
            
            if(!vendors[sellerId]) {
              vendors[sellerId] = { name: sellerName, items: [], status: item.status, logistics: item.deliveryDetails };
            }
            vendors[sellerId].items.push(item);
          });

          let vendorHtml = "";
          Object.keys(vendors).forEach(sId => {
            const v = vendors[sId];
            const itemsString = v.items.map(i => `${i.title} (x${i.quantity})`).join(", ");
            let statusClass = 'st-pending';
            if(v.status === 'Shipped') statusClass = 'st-shipped';
            if(v.status === 'Delivered') statusClass = 'st-delivered';
            if(v.status === 'Cancelled' || v.status === 'Returned') statusClass = 'st-cancelled';

            vendorHtml += `
              <div class="vendor-block d-flex justify-content-between align-items-center">
                <div style="flex: 1;">
                   <div class="fw-bold text-success">${v.name}</div>
                   <div class="small text-muted" style="font-size:11px;">${itemsString}</div>
                   <div class="mt-2">
                      <span class="st-badge ${statusClass}">${v.status}</span>
                      <small class="ms-2 text-muted" style="font-size:10px;">${v.logistics?.method || 'Method: N/A'}</small>
                   </div>
                </div>
                <div class="px-3">
                   ${v.logistics?.dispatchProof ? `<a href="${v.logistics.dispatchProof}" target="_blank"><img src="${v.logistics.dispatchProof}" class="proof-img"></a>` : '<span class="text-muted" style="font-size:10px;">No Proof</span>'}
                </div>
                <div class="d-flex flex-column gap-1">
                   <button class="btn btn-xs btn-success" onclick="adminForceAction('${order._id}', '${sId}', 'deliver')">Force Deliver</button>
                   <button class="btn btn-xs btn-danger" onclick="adminForceAction('${order._id}', '${sId}', 'refund')">Force Refund</button>
                </div>
              </div>`;
          });

          tbody.innerHTML += `
            <tr>
              <td>
                <div class="fw-bold">#${order._id.toString().slice(-6).toUpperCase()}</div>
                <div class="small text-muted">${new Date(order.createdAt).toLocaleDateString('en-GB')}</div>
              </td>
              <td>
                <div class="fw-bold text-dark">${order.user?.name || 'Guest'}</div>
                <div class="small text-muted">${order.user?.email || ''}</div>
              </td>
              <td>${vendorHtml}</td>
              <td class="text-center">
                <div class="fw-bold text-success">₹${order.totalAmount}</div>
                <div class="small badge bg-light text-dark border mb-1">${order.orderStatus}</div><br>
                <small class="text-muted" style="font-size:9px;">Pay: ${order.paymentStatus}</small>
              </td>
            </tr>`;
        });
        renderPagination(data.pagination);
      } else {
        tbody.innerHTML = `<tr><td colspan="4" class="text-center py-5">No orders found.</td></tr>`;
      }
    } catch (err) { console.error(err); }
  }

  async function adminForceAction(orderId, sellerId, type) {
    const actionName = type === 'deliver' ? "FORCE DELIVER" : "FORCE REFUND";
    if(!confirm(`Are you sure you want to ${actionName} for this specific Seller?`)) return;
    const url = type === 'deliver' ? '/admin/orders/force-deliver' : '/admin/orders/force-refund';
    try {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId, sellerId })
        });
        const data = await res.json();
        alert(data.message);
        if(data.success) loadOrders(currentPage);
    } catch (e) { alert("Action Failed"); }
  }

  // 🔥 RESTORED FULL PAGINATION LOGIC
  function renderPagination(pg) {
    const container = document.getElementById("paginationButtons");
    document.getElementById("paginationInfo").innerText = `Showing ${((pg.currentPage-1)*10)+1} to ${Math.min(pg.currentPage*10, pg.totalCount)} of ${pg.totalCount}`;
    
    let html = "";
    // Prev Button
    html += `<li class="page-item ${pg.currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadOrders(${pg.currentPage - 1})">Prev</a></li>`;
    
    // Page Numbers
    for(let i=1; i <= pg.totalPages; i++) {
        if(i === 1 || i === pg.totalPages || (i >= pg.currentPage - 1 && i <= pg.currentPage + 1)) {
            html += `<li class="page-item ${i === pg.currentPage ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadOrders(${i})">${i}</a></li>`;
        } else if (i === pg.currentPage - 2 || i === pg.currentPage + 2) {
            html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
        }
    }
    
    // Next Button
    html += `<li class="page-item ${pg.currentPage === pg.totalPages ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadOrders(${pg.currentPage + 1})">Next</a></li>`;
    container.innerHTML = html;
  }
</script>
</body>
</html>