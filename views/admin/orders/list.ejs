<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Orders - Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    body { font-family: 'Segoe UI', sans-serif; background: #f0f4f7; overflow-x: hidden; }
    #sidebar { position: fixed; left: 0; top: 0; width: 220px; height: 100vh; background: #1b5e20; padding-top: 60px; z-index: 1000; }
    #sidebar a { display: flex; align-items: center; gap: 12px; padding: 12px 20px; color: white; text-decoration: none; margin: 8px 10px; border-radius: 10px; transition: 0.3s; }
    #sidebar a:hover, #sidebar a.active { background: rgba(255,255,255,0.2); }
    #main-content { margin-left: 240px; padding: 30px; }
    
    .table-card { background: white; border-radius: 15px; padding: 25px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
    .table thead { background-color: #e8f5e9; color: #1b5e20; border-bottom: 2px solid #2e7d32; }
    
    .filter-card { background: white; border-radius: 15px; padding: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); margin-bottom: 20px; }
    .filter-label { font-size: 12px; color: #2e7d32; font-weight: 700; margin-bottom: 6px; display: inline-block; }

    /* Status Badges */
    .st-pending { background: #fff3cd; color: #856404; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; }
    .st-paid { background: #d1e7dd; color: #0f5132; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; }
    .st-cancelled { background: #f8d7da; color: #842029; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; }
    
    .pagination-wrapper { display: flex; justify-content: space-between; align-items: center; margin-top: 20px; }
    .page-link { color: #1b5e20; font-weight: 600; }
    .page-item.active .page-link { background-color: #1b5e20; border-color: #1b5e20; color: white; }
  </style>
</head>
<body>

<div id="sidebar">
  <h4 class="text-center text-white mb-4">Admin</h4>
  <a href="/admin/dashboard"><i class="fas fa-home"></i> Dashboard</a>
  <a href="/admin/orders" class="active"><i class="fas fa-shopping-cart"></i> All Orders</a>
  <a href="/admin/payouts"><i class="fas fa-money-bill-wave"></i> Payout Requests</a>
  <a href="/admin/sellers/master-list"><i class="fas fa-list-ol"></i> Master List</a>
  <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
</div>

<div id="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-success fw-bold">User Orders</h2>
    <button onclick="loadOrders(1)" class="btn btn-success shadow-sm"><i class="fas fa-sync"></i> Refresh</button>
  </div>

  <!-- Filters -->
  <div class="filter-card">
    <div class="row g-3">
      <div class="col-md-4">
        <span class="filter-label">Search Order</span>
        <input id="searchInput" type="text" class="form-control" placeholder="User Name, Email or Order ID..." onkeyup="if(event.key === 'Enter') applyFilters()">
      </div>
      <div class="col-md-2">
        <span class="filter-label">From Date</span>
        <input id="fromDate" type="date" class="form-control"/>
      </div>
      <div class="col-md-2">
        <span class="filter-label">To Date</span>
        <input id="toDate" type="date" class="form-control"/>
      </div>
      <div class="col-md-4 d-flex align-items-end gap-2">
        <button class="btn btn-success flex-grow-1 fw-bold" onclick="applyFilters()">Apply</button>
        <button class="btn btn-outline-secondary flex-grow-1 fw-bold" onclick="clearFilters()">Clear</button>
      </div>
    </div>
  </div>

  <!-- Orders Table -->
  <div class="table-card">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Amount</th>
            <th>Method</th>
            <th>Payment</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody id="orderTableBody"></tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="pagination-wrapper">
      <div id="paginationInfo" class="small text-muted">Showing 0 orders</div>
      <nav><ul class="pagination pagination-sm mb-0" id="paginationButtons"></ul></nav>
    </div>
  </div>
</div>

<script>
  let currentPage = 1;

  document.addEventListener("DOMContentLoaded", () => loadOrders(1));

  function applyFilters() { currentPage = 1; loadOrders(1); }
  function clearFilters() {
    document.getElementById("fromDate").value = "";
    document.getElementById("toDate").value = "";
    document.getElementById("searchInput").value = "";
    loadOrders(1);
  }

  async function loadOrders(page) {
    const from = document.getElementById("fromDate").value;
    const to = document.getElementById("toDate").value;
    const search = document.getElementById("searchInput").value;

    try {
      const tbody = document.getElementById("orderTableBody");
      tbody.innerHTML = `<tr><td colspan="7" class="text-center py-5">Loading...</td></tr>`;

      const params = new URLSearchParams({ page, limit: 10, from, to, search });
      const res = await fetch(`/admin/orders/data?${params.toString()}`);
      const data = await res.json();

      tbody.innerHTML = "";
      if (data.success && data.orders.length > 0) {
        data.orders.forEach(order => {
          const statusClass = order.orderStatus === 'Cancelled' ? 'st-cancelled' : 'st-pending';
          const payClass = order.paymentStatus === 'PAID' ? 'st-paid' : 'st-pending';
          
          tbody.innerHTML += `
            <tr>
              <td><small class="fw-bold">#${order._id.toString().slice(-6).toUpperCase()}</small></td>
              <td><strong>${order.user?.name || 'N/A'}</strong><br><span class="small text-muted">${order.user?.email || ''}</span></td>
              <td class="fw-bold text-success">₹${order.totalAmount}</td>
              <td><span class="badge bg-light text-dark border">${order.paymentMethod}</span></td>
              <td><span class="${payClass}">${order.paymentStatus}</span></td>
              <td><span class="${statusClass}">${order.orderStatus}</span></td>
              <td class="small">${new Date(order.createdAt).toLocaleDateString('en-IN')}</td>
            </tr>`;
        });
        renderPagination(data.pagination);
      } else {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-5 text-muted">No orders found.</td></tr>`;
        document.getElementById("paginationButtons").innerHTML = "";
      }
    } catch (err) { console.error(err); }
  }

  function renderPagination(pg) {
    const container = document.getElementById("paginationButtons");
    document.getElementById("paginationInfo").innerText = `Page ${pg.currentPage} of ${pg.totalPages} (${pg.totalCount} total)`;
    
    let html = "";
    html += `<li class="page-item ${pg.currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadOrders(${pg.currentPage - 1})">Prev</a></li>`;
    
    for(let i=1; i <= pg.totalPages; i++) {
        if(i === 1 || i === pg.totalPages || (i >= pg.currentPage - 1 && i <= pg.currentPage + 1)) {
            html += `<li class="page-item ${i === pg.currentPage ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadOrders(${i})">${i}</a></li>`;
        } else if (i === pg.currentPage - 2 || i === pg.currentPage + 2) {
            html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
        }
    }

    html += `<li class="page-item ${pg.currentPage === pg.totalPages ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadOrders(${pg.currentPage + 1})">Next</a></li>`;
    container.innerHTML = html;
  }
</script>
</body>
</html>