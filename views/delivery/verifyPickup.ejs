<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Return Pickup | BharatMkt</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <style>
        body { background: #f4f7f6; height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
        .pickup-card { background: #fff; padding: 30px; border-radius: 24px; shadow: 0 10px 30px rgba(0,0,0,0.08); width: 100%; max-width: 380px; text-align: center; border: 1px solid #eee; }
        .otp-field { font-size: 2rem; letter-spacing: 8px; text-align: center; font-weight: 900; border: 2px solid #eee; border-radius: 12px; margin-bottom: 20px; color: #ef4444; }
        .otp-field:focus { border-color: #ef4444; outline: none; box-shadow: 0 0 10px rgba(239,68,68,0.1); }
        .btn-verify { background: #ef4444; color: #fff; border: none; padding: 15px; border-radius: 12px; width: 100%; font-weight: 700; font-size: 1rem; transition: 0.3s; }
        .btn-verify:hover { background: #dc2626; transform: translateY(-2px); }
    </style>
</head>
<body>

    <div class="pickup-card shadow-lg mx-3">
        <div class="mb-3 text-danger"><i class='bx bx-refresh fs-1 animate-spin'></i></div>
        <h3 class="fw-bold">Return Pickup</h3>
        <p class="text-muted small mb-4">Order ID: #<%= orderId.slice(-6).toUpperCase() %></p>
        
        <div class="alert alert-warning py-2 small" style="font-size: 11px;">
            Ask customer for the <strong>Return Pickup OTP</strong> shown in their BharatMkt App.
        </div>

        <input type="number" id="otp-input" class="form-control otp-input otp-field" placeholder="0000" oninput="if(this.value.length > 4) this.value = this.value.slice(0,4);">
        
        <button onclick="verifyPickup()" id="verify-btn" class="btn-verify">
            VERIFY & COLLECT ITEM
        </button>

        <div id="status-msg" class="mt-3"></div>
    </div>

    <script>
        async function verifyPickup() {
            const otp = document.getElementById('otp-input').value;
            const btn = document.getElementById('verify-btn');
            const msg = document.getElementById('status-msg');

            if(otp.length !== 4) return alert("Please enter 4-digit OTP");

            btn.disabled = true;
            btn.innerText = "Verifying...";

            try {
                const res = await fetch('/api/order/verify-pickup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId: '<%= orderId %>', otp: otp })
                });
                const data = await res.json();

                if(data.success) {
                    msg.innerHTML = "<div class='alert alert-success fw-bold'>✔ Pickup Successful!</div>";
                    btn.innerText = "COMPLETED";
                    setTimeout(() => window.close(), 2000);
                } else {
                    msg.innerHTML = "<div class='alert alert-danger'>" + data.message + "</div>";
                    btn.disabled = false;
                    btn.innerText = "VERIFY & COLLECT ITEM";
                }
            } catch (err) {
                alert("Server error. Check internet connection.");
                btn.disabled = false;
                btn.innerText = "VERIFY & COLLECT ITEM";
            }
        }
    </script>
</body>
</html>