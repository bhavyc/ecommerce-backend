<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm Delivery | BharatMkt</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f4f7f6; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; font-family: 'Inter', sans-serif; }
        .confirm-card { background: #fff; padding: 35px; border-radius: 24px; shadow: 0 15px 35px rgba(0,0,0,0.1); width: 90%; max-width: 400px; text-align: center; border: 1px solid #eee; }
        .otp-input { font-size: 2.2rem; letter-spacing: 12px; text-align: center; border: 2px solid #eee; border-radius: 12px; margin-bottom: 25px; font-weight: 900; color: #10b981; }
        .btn-verify { background: #1f2937; color: #fff; padding: 18px; border-radius: 12px; width: 100%; font-weight: 800; border: none; transition: 0.3s; }
        .btn-verify:active { transform: scale(0.98); }
    </style>
</head>
<body>

    <div class="confirm-card shadow-lg">
        <div class="text-success mb-3"><i class='bx bxs-badge-check' style="font-size: 60px;"></i></div>
        <h3 class="fw-bold">BharatMkt Delivery</h3>
        <p class="text-muted small">Verify shipment for Order ID: #<%= orderId.slice(-6).toUpperCase() %></p>
        <hr>
        <p class="small fw-bold text-dark">Ask Customer for Delivery OTP</p>
        
        <input type="number" id="otp-code" class="form-control otp-input" placeholder="0000" maxlength="4">
        
        <button onclick="verifyDelivery()" id="v-btn" class="btn-verify">VERIFY & COMPLETE</button>
        
        <div id="msg" class="mt-3 small fw-bold"></div>
    </div>

    <script>
        async function verifyDelivery() {
            const otp = document.getElementById('otp-code').value;
            const btn = document.getElementById('v-btn');
            const msgDiv = document.getElementById('msg');
            
            // 🔥 URL PARAMETERS SE SELLER ID NIKALO
            const urlParams = new URLSearchParams(window.location.search);
            const sellerId = urlParams.get('sellerId');

            if(!otp || otp.length < 4) { alert("Enter valid 4-digit OTP"); return; }
            if(!sellerId) { alert("Invalid Delivery Link (Seller ID missing)"); return; }

            btn.disabled = true; btn.innerText = "Processing...";

            try {
                const res = await fetch('/api/order/verify-delivery', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        orderId: '<%= orderId %>', 
                        otp: otp,
                        sellerId: sellerId // Backend ko bhej rahe hain
                    })
                });
                const data = await res.json();
                
                if(data.success) {
                    msgDiv.className = "mt-3 text-success";
                    msgDiv.innerHTML = "✔ Delivery Confirmed!";
                    setTimeout(() => { document.body.innerHTML = "<h2 class='text-center fw-bold'>Shipment Completed!</h2>" }, 1500);
                } else {
                    msgDiv.className = "mt-3 text-danger";
                    msgDiv.innerHTML = "❌ " + data.message;
                    btn.disabled = false; btn.innerText = "VERIFY & COMPLETE";
                }
            } catch (err) { alert("Server connection failed"); btn.disabled = false; }
        }
    </script>
</body>
</html>