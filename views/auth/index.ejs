<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #d4f7d4, #a3e4a3);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .profile-box {
      background: white;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0px 4px 15px rgba(0, 128, 0, 0.2);
      width: 100%;
      max-width: 900px; /* Increased max-width to accommodate order list */
    }
    h1 {
      color: #2e7d32;
      font-weight: bold;
      margin-bottom: 15px;
    }
    h2 {
      color: #388e3c;
      margin-top: 25px;
      padding-bottom: 10px;
      border-bottom: 2px solid #e8f5e9;
    }
    .user-info {
      background: #f1f8f1;
      padding: 15px;
      border-radius: 12px;
      margin-bottom: 20px;
    }
    .order-list {
      list-style: none;
      padding: 0;
    }
    .order-list li {
      background: #e8f5e9;
      margin: 15px 0;
      padding: 15px;
      border-radius: 10px;
      border-left: 5px solid #2e7d32;
    }
    .no-data {
      color: #777;
      font-style: italic;
    }
    .btn-buy {
      margin-top: 10px;
    }
    .order-item-list {
      list-style: disc;
      padding-left: 20px;
      margin-top: 10px;
    }
    .order-status {
        font-weight: bold;
        padding: 5px 10px;
        border-radius: 5px;
        display: inline-block;
        font-size: 0.9em;
    }
    .status-Pending { background-color: #fff3cd; color: #664d03; }
    .status-Processing { background-color: #cfe2ff; color: #084298; }
    .status-Shipped { background-color: #d1e7dd; color: #0f5132; }
    .status-Delivered { background-color: #d1ecf1; color: #0c5460; }
    .status-Cancelled { background-color: #f8d7da; color: #721c24; }
  </style>
</head>
<body>
  <div class="profile-box">
    <h1> Welcome, <%= user.name %> </h1>

    <!-- User Info + Membership -->
    <div class="user-info">
      <p><strong>Email:</strong> <%= user.email %></p>
      <p><strong>Role:</strong> <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></p>
      <p>
        <strong>Membership:</strong> 
        <% if(user.isMember && user.membershipExpiry > new Date()){ %>
          <span class="badge bg-success">Active</span> (expires on <%= user.membershipExpiry.toLocaleDateString() %>)
        <% } else { %>
          <span class="badge bg-danger">Not Active</span>
          <form action="/membership/buy" method="POST" style="display:inline;" class="ms-3">
            <button class="btn btn-sm btn-success btn-buy">Buy Membership</button>
          </form>
        <% } %>
      </p>
    </div>

    <!-- User Orders -->
    <h2>Your Orders</h2>
    <% if(orders.length === 0){ %>
      <p class="no-data">You haven't placed any orders yet.</p>
    <% } else { %>
      <ul class="order-list">
        <% orders.forEach(order => { %>
          <li>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong>Order ID:</strong> <%= order._id.toString().slice(-8) %>
                <span class="order-status status-<%= order.orderStatus %>"><%= order.orderStatus %></span>
            </div>
            
            <p class="mb-1">
                <strong>Total Amount:</strong> ₹<%= order.totalAmount.toFixed(2) %> | 
                <strong>Placed At:</strong> <%= order.placedAt.toLocaleString() %>
            </p>
            
            <h6>Items:</h6>
            <ul class="order-item-list">
                <% order.items.forEach(item => { %>
                    <li>
                        <%= item.title %> (<%= item.itemType %>) - 
                        Qty: <%= item.quantity %>, 
                        Price: ₹<%= item.price %> 
                        <% if(item.discount > 0) { %>
                           (<%= item.discount %>% off)
                        <% } %>
                    </li>
                <% }) %>
            </ul>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <!-- Logout -->
    <form action="/auth/logout" method="POST" class="mt-3">
      <button class="btn btn-danger">Logout</button>
    </form>
  </div>
</body>
</html>