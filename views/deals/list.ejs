<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>🔥 Active 24-Hour Deals</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #e0f7fa 0%, #e1f5fe 100%);
      min-height: 100vh;
      padding-top: 50px;
      padding-bottom: 50px;
    }
    
    h2 {
      text-align: center;
      font-weight: 700;
      color: #01579b;
      margin-bottom: 40px;
    }

    /* Card Styling */
    .card {
      border: none;
      border-radius: 15px;
      box-shadow: 0 10px 20px rgba(0,0,0,0.08);
      transition: transform 0.3s ease; /* Iski wajah se modal blink ho raha tha */
      overflow: hidden;
      background: white;
    }
    
    /* Hover effect sirf card par rahega, modal par nahi */
    .card:hover {
      transform: translateY(-5px);
    }

    .card-img-top {
      height: 220px;
      object-fit: cover;
    }

    /* Badges */
    .badge-pos { position: absolute; top: 15px; z-index: 10; }
    .badge-featured { left: 15px; background: #ffeb3b; color: #000; font-weight: bold; padding: 5px 12px; border-radius: 20px; }
    .badge-group { right: 15px; background: #6200ea; color: #fff; font-weight: bold; padding: 5px 12px; border-radius: 20px; }

    /* Pricing */
    .price-area { min-height: 60px; display: flex; flex-direction: column; justify-content: center; }
    .solo-price { font-size: 0.95rem; color: #555; }
    .team-price { font-size: 1.3rem; color: #6200ea; font-weight: 800; }
    .team-label { font-size: 0.75rem; text-transform: uppercase; background: #ede7f6; color: #6200ea; padding: 2px 6px; border-radius: 4px; margin-left: 5px; }
    
    .countdown { font-size: 0.85rem; color: #d32f2f; font-weight: 600; margin-bottom: 15px; }

    /* Buttons */
    .btn-cart { background-color: #00c853; color: white; border: none; font-weight: 600; border-radius: 8px; }
    .btn-cart:hover { background-color: #009624; color: white; }
    .btn-team { background: linear-gradient(45deg, #651fff, #7c4dff); color: white; border: none; font-weight: 600; border-radius: 8px; margin-top: 8px; }
    .btn-team:hover { background: linear-gradient(45deg, #4a148c, #651fff); color: white; }
  </style>
</head>
<body class="container">

<h2>🔥 Active 24-Hour Deals</h2>

<% if (deals && deals.length > 0) { %>
  <div class="row row-cols-1 row-cols-md-3 g-4">
    
    <!-- 🟢 LOOP 1: Sirf Cards Display karne ke liye -->
    <% deals.forEach(deal => { %>
      <div class="col">
        <div class="card h-100 position-relative">
          
          <% if (deal.featured) { %> <span class="badge badge-featured badge-pos">⭐ Featured</span> <% } %>
          <% if (deal.isGroupBuyAvailable) { %> <span class="badge badge-group badge-pos">👥 Team Deal</span> <% } %>

          <img src="<%= deal.image || 'https://via.placeholder.com/300' %>" class="card-img-top" alt="<%= deal.title %>">

          <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold"><%= deal.title %></h5>
            <p class="card-text text-muted small"><%= deal.description %></p>

            <div class="price-area my-2">
              <% if (deal.isGroupBuyAvailable) { %>
                <div class="solo-price">Solo: <span class="text-decoration-line-through">₹<%= deal.price %></span> <span class="fw-bold text-dark">₹<%= deal.discountedPrice %></span></div>
                <div class="team-price">₹<%= deal.groupPrice %> <span class="team-label">Team Price</span></div>
              <% } else { %>
                <div class="team-price text-success">₹<%= deal.discountedPrice %></div>
              <% } %>
            </div>

            <div class="countdown" data-created="<%= deal.createdAt %>">Loading...</div>

            <div class="mt-auto">
              <% if (!user) { %>
                <a href="/auth/login" class="btn btn-outline-primary w-100">Login to Buy</a>
              <% } else { %>
                <!-- Standard Cart -->
                <form action="/cart/add" method="POST" class="d-grid">
                  <input type="hidden" name="userId" value="<%= user._id %>">
                  <input type="hidden" name="itemId" value="<%= deal._id %>">
                  <input type="hidden" name="itemType" value="24HrDeal">
                  <button type="submit" class="btn btn-cart py-2">🛒 Add to Cart</button>
                </form>

                <!-- Group Buy Button -->
                <% if (deal.isGroupBuyAvailable) { %>
                  <button type="button" class="btn btn-team w-100 py-2" data-bs-toggle="modal" data-bs-target="#groupModal-<%= deal._id %>">
                    👥 Buy with Team (₹<%= deal.groupPrice %>)
                  </button>
                <% } %>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% }) %>

  </div>
<% } else { %>
  <div class="text-center mt-5"><h3>No Active Deals</h3></div>
<% } %>

<!-- 
  🔴 MODALS KO LOOP KE BAHAR RAKHA HAI 
  Ye body ke end mein rahenge taaki card ka CSS transform inhe effect na kare 
-->
<% if (user && deals && deals.length > 0) { %>
  <% deals.forEach(deal => { %>
    <% if (deal.isGroupBuyAvailable) { %>
      <div class="modal fade" id="groupModal-<%= deal._id %>" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <form action="/group/start" method="POST">
              <div class="modal-header bg-light">
                <h5 class="modal-title">Start Team for <%= deal.title %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <!-- Info Alert -->
                <div class="alert alert-info py-2 mb-3 border-0" style="background-color: #e3f2fd; color: #0d47a1;">
                   <div class="d-flex justify-content-between align-items-center">
                      <span>Team Price: <strong>₹<%= deal.groupPrice %></strong></span>
                      <span class="badge bg-primary">Save ₹<%= deal.discountedPrice - deal.groupPrice %></span>
                   </div>
                   <small>Need <%= (deal.groupSize || 2) - 1 %> more friend(s) to join.</small>
                </div>

                <input type="hidden" name="dealId" value="<%= deal._id %>">
                
                <div class="mb-3">
                  <label class="form-label fw-bold">Full Name</label>
                  <input type="text" name="addressData[fullName]" class="form-control" value="<%= user.name %>" required>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">Address</label>
                  <input type="text" name="addressData[addressLine1]" class="form-control" required placeholder="House No / Street">
                </div>

                <div class="row g-2 mb-3">
                  <div class="col">
                    <input type="text" name="addressData[city]" class="form-control" placeholder="City" required>
                  </div>
                  <div class="col">
                    <input type="text" name="addressData[postalCode]" class="form-control" placeholder="Pincode" required>
                  </div>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">Payment Method</label>
                  <select name="paymentMethod" class="form-select">
                    <option value="COD">Cash on Delivery</option>
                    <option value="UPI">UPI / Online</option>
                  </select>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-team px-4">Confirm & Start</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% } %>
  <% }) %>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Timer Script
  document.querySelectorAll('.countdown').forEach(el => {
    const created = new Date(el.dataset.created).getTime();
    const expiry = created + (24 * 60 * 60 * 1000);
    
    setInterval(() => {
      const now = new Date().getTime();
      const diff = expiry - now;
      if (diff < 0) {
        el.innerHTML = "Expired"; el.style.color = "grey";
      } else {
        const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((diff % (1000 * 60)) / 1000);
        el.innerHTML = `⏳ Expires in: ${h}h ${m}m ${s}s`;
      }
    }, 1000);
  });
</script>

</body>
</html>