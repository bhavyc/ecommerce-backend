<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Secure Seller Login">
  <title>Seller Login</title>
  
  <!-- Font: Inter (Cleanest font for UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Bootstrap 5 (Grid & Utils only) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root {
      /* Minimalist Color Palette */
      --primary: #10b981;       /* Clean Green */
      --primary-hover: #059669;
      --bg-body: #F3F4F6;       /* Soft Gray */
      --bg-card: #FFFFFF;
      --text-main: #111827;
      --text-muted: #6B7280;
      --border-color: #E5E7EB;
      --focus-ring: rgba(16, 185, 129, 0.25);
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-body);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    /* Card Container */
    .login-container {
      width: 100%;
      max-width: 440px;
      background: var(--bg-card);
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 
                  0 10px 15px -3px rgba(0, 0, 0, 0.05);
      padding: 40px;
      border: 1px solid rgba(0,0,0,0.03);
    }

    /* Logo & Header */
    .brand-header {
      text-align: center;
      margin-bottom: 32px;
    }
    .brand-logo {
      font-size: 24px;
      color: var(--primary);
      margin-bottom: 16px;
      display: inline-block;
    }
    
    .brand-header h1 {
      font-size: 24px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    .brand-header p {
      color: var(--text-muted);
      font-size: 14px;
    }

    /* Form Elements */
    .form-label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-main);
      margin-bottom: 6px;
    }

    .form-control {
      padding: 10px 12px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      font-size: 15px;
      color: var(--text-main);
      transition: all 0.2s ease;
      background-color: #fff;
    }

    .form-control:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px var(--focus-ring);
      outline: none;
    }

    /* Button */
    .btn-submit {
      background-color: var(--primary);
      color: white;
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 15px;
      border: 1px solid transparent;
      transition: background 0.2s;
      margin-top: 8px;
    }
    .btn-submit:hover {
      background-color: var(--primary-hover);
      color: white;
    }

    /* Links */
    .link-primary {
      color: var(--primary);
      text-decoration: none;
      font-weight: 500;
      font-size: 14px;
    }
    .link-primary:hover {
      color: var(--primary-hover);
      text-decoration: underline;
    }

    /* Password Toggle */
    .input-group-text {
      background: transparent;
      border-left: none;
      border-color: var(--border-color);
      border-radius: 0 8px 8px 0;
      cursor: pointer;
      color: var(--text-muted);
    }
    .password-input {
      border-right: none;
      border-radius: 8px 0 0 8px;
    }
    /* Fix focus border when input group used */
    .password-input:focus { z-index: 1; } 

    /* Utilities */
    .text-sm { font-size: 14px; }
    .text-muted-sm { color: var(--text-muted); font-size: 14px; }
  </style>
</head>
<body>

  <div class="login-container">
    
    <!-- Header -->
    <div class="brand-header">
      <div class="brand-logo">
        <i class="fa-solid fa-cube"></i> <!-- Replace with your logo img if needed -->
      </div>
      <h1>Welcome back</h1>
      <p>Please enter your details to sign in.</p>
    </div>

    <!-- Form -->
    <form action="/seller/auth/login" method="POST" class="needs-validation" novalidate>
      
      <!-- Email -->
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" name="email" id="email" placeholder="Enter your email" required>
        <div class="invalid-feedback text-sm">Valid email is required.</div>
      </div>

      <!-- Password -->
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <div class="input-group has-validation">
          <input type="password" class="form-control password-input" name="password" id="password" placeholder="••••••••" required>
          <span class="input-group-text" onclick="togglePass()">
            <i class="fa-regular fa-eye" id="eyeIcon"></i>
          </span>
          <div class="invalid-feedback text-sm">Password is required.</div>
        </div>
      </div>

      <!-- Remember & Forgot -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <!-- <div class="form-check">
          <input class="form-check-input" type="checkbox" id="remember" name="remember">
          <label class="form-check-label text-muted-sm" for="remember">
            Remember me
          </label>
        </div> -->
        <!-- <a href="/seller/auth/forgot-password" class="link-primary">Forgot password?</a> -->
      </div>

      <!-- Submit -->
      <button type="submit" class="btn-submit" id="submitBtn">Sign in</button>

    </form>

    <!-- Footer -->
    <div class="text-center mt-4 text-muted-sm">
      Don't have an account? <a href="/seller/auth/register" class="link-primary">Sign up</a>
    </div>

  </div>

  <script>
    // 1. Password Visibility Toggle
    function togglePass() {
      const passwordInput = document.getElementById('password');
      const icon = document.getElementById('eyeIcon');
       console.log("it was clicked")
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        passwordInput.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }

    // 2. Client-side Validation (Bootstrap Standard)
    (function () {
      'use strict'
      var forms = document.querySelectorAll('.needs-validation')
      Array.prototype.slice.call(forms).forEach(function (form) {
        form.addEventListener('submit', function (event) {
          if (!form.checkValidity()) {
            event.preventDefault()
            event.stopPropagation()
          } else {
           // Optional: Show loading state
            const btn = document.getElementById('submitBtn');
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Signing in...';
            btn.disabled = true;
          }
          form.classList.add('was-validated')
        }, false)
      })
    })()
  </script>

</body>
</html>