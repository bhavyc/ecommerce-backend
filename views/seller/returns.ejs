<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Return Requests | Seller Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root { --primary: #10b981; --danger: #ef4444; --warning: #f59e0b; --bg-body: #f3f4f6; --sidebar-width: 260px; }
    body { font-family: 'Inter', sans-serif; background-color: var(--bg-body); margin: 0; }
    .sidebar { width: var(--sidebar-width); background: #1f2937; color: #fff; position: fixed; height: 100vh; padding-top: 20px; z-index: 1000; }
    .nav-item { display: flex; align-items: center; padding: 12px 20px; color: #d1d5db; text-decoration: none; }
    .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.1); color: #fff; }
    .nav-item i { margin-right: 12px; font-size: 20px; }
    .main-content { margin-left: var(--sidebar-width); padding: 40px; }
    .returns-card { border: none; border-radius: 16px; background: white; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 20px; border-left: 5px solid var(--danger); }
    .reason-box { background: #fef2f2; border: 1px solid #fee2e2; padding: 12px; border-radius: 12px; font-size: 0.85rem; color: #991b1b; margin-bottom: 15px; }
    .status-badge { font-size: 10px; padding: 4px 10px; border-radius: 20px; font-weight: 700; text-transform: uppercase; }
    .product-thumb { width: 40px; height: 40px; object-fit: cover; border-radius: 6px; }
    .btn-action { border-radius: 20px; font-weight: 700; padding: 8px 20px; font-size: 12px; }
  </style>
</head>
<body>

  <aside class="sidebar" id="sidebar">
    <div class="px-4 mb-4"><h4 class="text-success fw-bold mb-0">SellerPanel</h4></div>
    <nav>
      <a href="/seller/dashboard" class="nav-item"><i class='bx bxs-dashboard'></i> Dashboard</a>
      <a href="/seller/daily-orders" class="nav-item"><i class='bx bxs-truck'></i> Today's Orders</a>
      <a href="/sellers/returns" class="nav-item active"><i class='bx bx-undo'></i> Return Requests</a>
      <a href="/seller/inventory" class="nav-item"><i class='bx bxs-box'></i> Inventory</a>
      <a href="/seller/wallet" class="nav-item"><i class='bx bxs-wallet'></i> Wallet</a>
      <a href="/seller/auth/logout" class="nav-item text-danger mt-5"><i class='bx bx-log-out'></i> Logout</a>
    </nav>
  </aside>

  <main class="main-content">
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold mb-1">🔄 Returns & Pickups</h2><p class="text-muted small">Manage item returns and process refunds.</p></div>
    </div>

    <div class="returns-container">
        <% if (orders.length === 0) { %>
            <div class="text-center py-5 bg-white rounded-4 border"><h5>No pending returns!</h5></div>
        <% } else { %>
            <% orders.forEach(order => { 
                // 🔥 LOGIC: Check if any item belonging to this seller is already PICKED_UP
                const isItemPickedUp = order.itemsToReturn.some(it => it.status === 'Picked_Up');
                const isItemAssigned = order.itemsToReturn.some(it => it.status === 'PICKUP_ASSIGNED');
                const isCourier = order.returnDetails.pickupMethod === 'COURIER';
            %>
                <div class="card returns-card mb-3">
                    <div class="card-body p-4">
                        <div class="row g-4 align-items-center">
                            <!-- Order Info -->
                            <div class="col-lg-3">
                                <span class="badge bg-dark rounded-pill mb-2">#<%= order._id.toString().slice(-6).toUpperCase() %></span>
                                
                                <% 
                                    let displayStatus = order.itemsToReturn[0].status; // Item status primary hai
                                    let statusColor = "bg-danger-subtle text-danger";
                                    if(displayStatus === 'PICKUP_ASSIGNED') statusColor = "bg-warning-subtle text-warning";
                                    if(displayStatus === 'Picked_Up') statusColor = "bg-success-subtle text-success";
                                %>
                                <div class="status-badge <%= statusColor %> d-block mb-2 text-center">
                                    <%= displayStatus.replace("_", " ") %>
                                </div>
                                <h5 class="fw-bold mb-1"><%= order.user.name %></h5>
                                <p class="small text-muted mb-0"><%= order.user.phone %></p>
                            </div>

                            <!-- Items -->
                            <div class="col-lg-5 px-lg-4">
                                <div class="reason-box mb-2"><strong>Reason:</strong> <%= order.returnDetails.reason %></div>
                                <div class="p-2 bg-light rounded border">
                                    <% order.itemsToReturn.forEach(item => { %>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="d-flex align-items-center">
                                                <img src="<%= item.image %>" class="product-thumb me-2">
                                                <span class="small text-truncate" style="max-width: 120px;"><%= item.title %></span>
                                            </div>
                                            <span class="fw-bold small">x<%= item.quantity %></span>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="col-lg-4 text-end">
                                <h3 class="fw-bold text-danger mb-3">₹<%= order.sellerRefundableAmount %></h3>
                                
                                <div class="d-flex gap-2 justify-content-end flex-wrap">
                                    
                                    <% if(displayStatus === 'Return_Requested') { %>
                                        <!-- Case 1: Assign Boy -->
                                        <button class="btn btn-danger btn-action px-4" data-bs-toggle="modal" data-bs-target="#pickupModal<%= order._id %>">Assign Pickup</button>
                                        <button onclick="handleAction('<%= order._id %>', 'REJECT')" class="btn btn-outline-secondary btn-action">Reject</button>

                                    <% } else if(isItemPickedUp || (isItemAssigned && isCourier)) { %>
                                        <!-- 🔥 Case 2: Refund Trigger (Boy OTP verified OR Courier assigned) -->
                                        <button onclick="handleAction('<%= order._id %>', 'APPROVE')" class="btn btn-success btn-action px-4 shadow-sm">
                                            <i class='bx bx-check-circle me-1'></i> Receive & Refund
                                        </button>
                                        <button class="btn btn-outline-dark btn-action" data-bs-toggle="modal" data-bs-target="#pickupModal<%= order._id %>">Edit Info</button>

                                    <% } else if(isItemAssigned && !isCourier) { %>
                                        <!-- Case 3: Local boy waiting for OTP -->
                                        <button class="btn btn-warning btn-action text-white" disabled><i class='bx bx-time'></i> Waiting for Boy (OTP)</button>
                                        <button class="btn btn-outline-dark btn-action" data-bs-toggle="modal" data-bs-target="#pickupModal<%= order._id %>">Resend Link</button>
                                    <% } %>

                                </div>
                                <div class="mt-2 small text-muted">Method: <b><%= order.returnDetails.pickupMethod || 'Not Set' %></b></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal remains the same but ensure it uses processPickupAssign -->
                <div class="modal fade" id="pickupModal<%= order._id %>" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content p-4 rounded-4 border-0 shadow">
                            <h5 class="fw-bold mb-3">Return Pickup Details</h5>
                            <select class="form-select mb-3" id="p-method-<%= order._id %>" onchange="toggleFields('<%= order._id %>')">
                                <option value="SELF" <%= order.returnDetails.pickupMethod === 'SELF' ? 'selected' : '' %>>Local Delivery Boy (OTP)</option>
                                <option value="COURIER" <%= order.returnDetails.pickupMethod === 'COURIER' ? 'selected' : '' %>>Courier Service (Receipt Upload)</option>
                            </select>

                            <div id="p-self-<%= order._id %>" style="<%= order.returnDetails.pickupMethod === 'COURIER' ? 'display:none' : '' %>">
                                <input type="text" id="p-boy-<%= order._id %>" class="form-control mb-2" placeholder="Boy Name" value="<%= order.returnDetails.pickupBoyName || '' %>">
                                <input type="tel" id="p-phone-<%= order._id %>" class="form-control mb-2" placeholder="WhatsApp Number" value="<%= order.returnDetails.pickupBoyPhone || '' %>">
                            </div>

                            <div id="p-courier-<%= order._id %>" style="<%= order.returnDetails.pickupMethod === 'COURIER' ? '' : 'display:none' %>">
                                <input type="text" id="p-cname-<%= order._id %>" class="form-control mb-2" placeholder="Courier Name" value="<%= order.returnDetails.courierName || '' %>">
                                <input type="text" id="p-tid-<%= order._id %>" class="form-control mb-2" placeholder="Tracking ID" value="<%= order.returnDetails.trackingId || '' %>">
                                <input type="file" id="p-proof-<%= order._id %>" class="form-control mb-2">
                            </div>

                            <button class="btn btn-danger w-100 mt-3 py-2 fw-bold" id="p-btn-<%= order._id %>" onclick="processPickupAssign('<%= order._id %>')">UPDATE PICKUP</button>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleFields(id) {
        const method = document.getElementById('p-method-' + id).value;
        document.getElementById('p-self-' + id).style.display = method === 'SELF' ? 'block' : 'none';
        document.getElementById('p-courier-' + id).style.display = method === 'COURIER' ? 'block' : 'none';
    }

    async function processPickupAssign(id) {
        const method = document.getElementById('p-method-' + id).value;
        const btn = document.getElementById('p-btn-' + id);
        btn.disabled = true;

        const formData = new FormData();
        formData.append('orderId', id);
        formData.append('method', method);

        if (method === 'SELF') {
            formData.append('boyName', document.getElementById('p-boy-' + id).value);
            formData.append('boyPhone', document.getElementById('p-phone-' + id).value);
        } else {
            formData.append('courierName', document.getElementById('p-cname-' + id).value);
            formData.append('trackingId', document.getElementById('p-tid-' + id).value);
            formData.append('pickupProof', document.getElementById('p-proof-' + id).files[0]);
        }

        try {
            const res = await fetch('/sellers/order/assign-pickup', { method: 'POST', body: formData });
            const data = await res.json();
            if(data.success) {
                if(method === 'SELF') {
                    const phone = document.getElementById('p-phone-' + id).value;
                    const link = `${window.location.origin}/delivery/verify-return/${id}`;
                    window.open(`https://wa.me/91${phone}?text=Pickup Link: ${link}`, '_blank');
                }
                location.reload();
            } else { alert(data.message); btn.disabled = false; }
        } catch (e) { alert("Server error"); btn.disabled = false; }
    }

    async function handleAction(orderId, action) {
        if(!confirm("Proceed with this action?")) return;
        try {
            const res = await fetch('/sellers/order/process-refund', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId, action })
            });
            const data = await res.json();
            alert(data.message);
            location.reload();
        } catch (err) { alert("Error"); }
    }
  </script>
</body>
</html>