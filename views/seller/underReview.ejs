<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Under Review | Seller Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: #f4f6f8;
      margin: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    } 
              
    .container {
      background: #fff;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
      text-align: center;
      max-width: 500px;
    }
    h1 {
      color: #ff9800;
      margin-bottom: 20px;
    }
    p {
      color: #555;
      font-size: 16px;
      line-height: 1.5;
    }
    .icon {
      font-size: 60px;
      color: #ff9800;
      margin-bottom: 20px;
    }

    a {
      display: inline-block;
      margin-top: 25px;
      padding: 12px 30px;
      background-color: #4caf50;
      color: #fff;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 600;
      transition: 0.3s;
    }
       
    a:hover {
      background-color: #45a049;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="icon">⏳</div>
    <h1>Account Under Review</h1>
    <p>
      Thank you for registering as a seller. Your account is currently under review.
      <br>
      Our team will verify your details and notify you once your account is approved.
    </p>
    <a href="/seller/auth/login">Back to Login</a>
  </div>
</body>
</html>



