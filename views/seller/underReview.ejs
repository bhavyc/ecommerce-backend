<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Under Review | Seller Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: #f4f6f8;
      margin: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    } 
              
    .container {
      background: #fff;
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.1);
      text-align: center;
      max-width: 480px;
      width: 90%;
    }

    h1 {
      color: #333;
      margin-bottom: 10px;
      font-size: 24px;
    }

    p {
      color: #666;
      font-size: 15px;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .icon {
      font-size: 50px;
      margin-bottom: 20px;
      display: inline-block;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }

    /* --- DigiLocker Section Styles --- */
    .kyc-box {
      background: #e3f2fd;
      border: 1px solid #bbdefb;
      border-radius: 10px;
      padding: 20px;
      margin-top: 25px;
      text-align: left;
    }

    .kyc-title {
      color: #0d47a1;
      font-weight: 600;
      font-size: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .digilocker-btn {
      display: block;
      width: 100%;
      text-align: center;
      margin-top: 15px;
      padding: 12px;
      background-color: #1976d2; /* DigiLocker Blue */
      color: #fff;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      box-shadow: 0 4px 6px rgba(25, 118, 210, 0.2);
      transition: 0.3s;
      border: none;
      cursor: pointer;
    }

    .digilocker-btn:hover {
      background-color: #1565c0;
      transform: translateY(-2px);
    }

    /* --- Verified Success Style --- */
    .verified-box {
      background: #e8f5e9;
      border: 1px solid #c8e6c9;
      border-radius: 10px;
      padding: 20px;
      margin-top: 25px;
      color: #2e7d32;
    }

    .verified-badge {
      font-weight: bold;
      font-size: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 5px;
    }

    /* --- Standard Links --- */
    .back-link {
      display: inline-block;
      margin-top: 25px;
      color: #777;
      text-decoration: none;
      font-size: 14px;
      border-bottom: 1px solid transparent;
      transition: 0.3s;
    }
       
    .back-link:hover {
      color: #333;
      border-bottom: 1px solid #333;
    }
  </style>
</head>
<body>
  <div class="container">
    
    <!-- Status Icon -->
    <div class="icon">⏳</div>
    
    <h1>Account Under Review</h1>
    
    <p>
      Thank you for registering! Your application has been received and is currently being reviewed by our admin team.
    </p>

    <!-- DIGILOCKER SECTION START -->
    <% if (typeof profile !== 'undefined' && profile.digiLockerData && profile.digiLockerData.isAadhaarVerified) { %>
      
      <!-- CASE 1: Aadhaar Already Verified -->
      <div class="verified-box">
        <div class="verified-badge">
          ✅ Identity Verified
        </div>
        <div style="font-size: 14px;">
          <strong>Name:</strong> <%= profile.digiLockerData.aadhaarName %>
        </div>
        <small style="opacity: 0.8;">Verified via DigiLocker</small>
      </div>
      <p style="margin-top: 15px; font-size: 13px;">
        Sit tight! We will verify your business documents shortly.
      </p>

    <% } else { %>
      
      <!-- CASE 2: Not Verified Yet -->
      <div class="kyc-box">
        <div class="kyc-title">
          ⚡ Speed Up Your Approval
        </div>
        <p style="margin: 8px 0 0; font-size: 13px; color: #444;">
          Verify your Aadhaar instantly using DigiLocker. Verified profiles get approved 2x faster.
        </p>
        
        <a href="/seller/kyc/digilocker/init" class="digilocker-btn">
          Verify via DigiLocker
        </a>
      </div>

    <% } %>
    <!-- DIGILOCKER SECTION END -->

    <br>
    <a href="/seller/auth/logout" class="back-link">Log out & Check Later</a>
  </div>
</body>
</html>