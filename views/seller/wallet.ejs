<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seller Wallet | Seller Panel</title>
  
  <!-- Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

  <style>
    :root {
      --primary: #10b981;
      --primary-dark: #059669;
      --pending: #f59e0b;
      --bg-body: #f3f4f6;
      --sidebar-width: 260px;
      --transition: all 0.3s ease;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-body);
      margin: 0;
    }

    /* Sidebar Styling */
    .sidebar {
      width: var(--sidebar-width);
      background: #1f2937;
      color: #fff;
      position: fixed;
      height: 100vh;
      padding-top: 20px;
      transition: var(--transition);
      z-index: 1000;
    }
    .nav-item {
      display: flex;
      align-items: center;
      padding: 12px 20px;
      color: #d1d5db;
      text-decoration: none;
      transition: 0.3s;
    }
    .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.1); color: #fff; }
    .nav-item i { margin-right: 12px; font-size: 20px; }

    /* Main Content */
    .main-content {
      margin-left: var(--sidebar-width);
      padding: 40px;
      transition: var(--transition);
    }

    /* Mobile Header */
    .mobile-header {
      display: none;
      background: #fff;
      padding: 15px 20px;
      border-bottom: 1px solid #e5e7eb;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 900;
    }

    /* Wallet UI Components */
    .balance-card {
      border: none;
      border-radius: 20px;
      padding: 30px;
      color: white;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    .card-available { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
    .card-pending { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }

    .balance-card i.bg-icon {
        position: absolute;
        right: -20px;
        bottom: -20px;
        font-size: 120px;
        opacity: 0.2;
    }

    .withdraw-section {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    /* Table Styling */
    .history-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        overflow: hidden;
    }
    .table thead th {
        background: #f9fafb;
        color: #6b7280;
        font-size: 12px;
        text-transform: uppercase;
        padding: 16px;
        border: none;
    }
    .badge-status {
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 11px;
        font-weight: 700;
    }
    .PENDING { background: #fef3c7; color: #92400e; }
    .APPROVED { background: #d1fae5; color: #065f46; }
    .PAID { background: #dbeafe; color: #1e40af; }
    .REJECTED { background: #fee2e2; color: #991b1b; }

    /* Pagination */
    .page-link { color: #374151; border: none; font-weight: 600; margin: 0 2px; border-radius: 8px !important; }
    .active > .page-link { background-color: var(--primary) !important; border: none; }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 999;
    }

    /* Responsive */
    @media (max-width: 991.98px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .main-content { margin-left: 0; padding: 20px; }
      .mobile-header { display: flex; }
      .sidebar-overlay.active { display: block; }
    }
  </style>
</head>
<body>

  <div class="sidebar-overlay" id="overlay" onclick="toggleSidebar()"></div>

  <!-- Mobile Header -->
  <header class="mobile-header no-print">
    <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
    <button class="btn btn-dark" onclick="toggleSidebar()"><i class='bx bx-menu-alt-left fs-3'></i></button>
  </header>

  <!-- Sidebar -->
  <aside class="sidebar no-print" id="sidebar">
    <div class="px-4 mb-4 d-flex justify-content-between align-items-center">
        <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
        <button class="btn text-white d-lg-none" onclick="toggleSidebar()"><i class='bx bx-x fs-3'></i></button>
    </div>
    <nav>
      <a href="/seller/dashboard" class="nav-item"><i class='bx bxs-dashboard'></i> Dashboard</a>
      <a href="/seller/daily-orders" class="nav-item"><i class='bx bxs-truck'></i> Today's Orders</a>
      <a href="/sellers/returns" class="nav-item"><i class='bx bx-undo'></i> Return Requests</a>
      <a href="/seller/inventory" class="nav-item"><i class='bx bxs-box'></i> Inventory</a>
      <a href="/seller/wallet" class="nav-item active"><i class='bx bxs-wallet'></i> Wallet</a>
      <a href="/seller/slots/history" class="nav-item"><i class='bx bxs-time-five'></i> Slot History</a>
      <a href="/seller/auth/logout" class="nav-item text-danger mt-5"><i class='bx bx-log-out'></i> Logout</a>
    </nav>
  </aside>

  <main class="main-content">
    <div class="mb-4">
        <h2 class="fw-bold">My Wallet</h2>
        <p class="text-muted small">Manage your earnings and payout requests.</p>
    </div>

    <!-- Balance Grid -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="balance-card card-available">
                <i class='bx bxs-wallet bg-icon'></i>
                <h6 class="text-uppercase fw-bold small opacity-75">Available to Withdraw</h6>
                <h1 class="display-5 fw-bold mb-0" id="walletBalance">₹0.00</h1>
            </div>
        </div>
        <div class="col-md-6">
            <div class="balance-card card-pending">
                <i class='bx bxs-time-five bg-icon'></i>
                <h6 class="text-uppercase fw-bold small opacity-75">On Hold (Pending)</h6>
                <h1 class="display-5 fw-bold mb-0" id="pendingBalance">₹0.00</h1>
                <p class="small mb-0 mt-2 opacity-75"><i class='bx bx-info-circle'></i> Funds move to available after validation.</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Withdrawal Form -->
        <div class="col-lg-4">
            <div class="withdraw-section h-100">
                <h5 class="fw-bold mb-3">Request Payout</h5>
                <p class="text-muted small">Enter the amount you wish to transfer to your linked bank account.</p>
                
                <div class="mb-3">
                    <label class="form-label small fw-bold">Amount (Min ₹100)</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0 bg-white">₹</span>
                        <input type="number" id="payoutAmount" class="form-control border-start-0 ps-0" placeholder="0.00">
                    </div>
                </div>

                <button onclick="requestPayout()" class="btn btn-success w-100 py-3 fw-bold shadow-sm btn-withdraw">
                    <i class='bx bx-right-arrow-alt'></i> Withdraw Now
                </button>
            </div>
        </div>

        <!-- Payout History -->
        <div class="col-lg-8">
            <div class="history-card h-100">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Recent Payouts</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Note</th>
                            </tr>
                        </thead>
                        <tbody id="payoutHistoryBody">
                            <tr><td colspan="4" class="text-center py-5">Loading history...</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center" id="paginationControls" style="display:none;">
                    <span class="small text-muted" id="pageInfo">Page 1 of 1</span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item"><button id="prevBtn" class="page-link" onclick="changePage(-1)">Prev</button></li>
                            <li class="page-item"><button id="nextBtn" class="page-link" onclick="changePage(1)">Next</button></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script>
    let currentPage = 1;
    let totalPages = 1;

    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('overlay').classList.toggle('active');
    }

    document.addEventListener("DOMContentLoaded", async () => {
      await fetchWalletData();
      await fetchHistory(1);
    });

    async function fetchWalletData() {
      try {
        const res = await fetch("/seller/payouts/balance");
        const data = await res.json();
        if(data.success) {
          document.getElementById("walletBalance").innerText = `₹${(data.walletBalance || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
          document.getElementById("pendingBalance").innerText = `₹${(data.pendingBalance || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})}`;
        }
      } catch (err) { console.error(err); }
    }

    async function fetchHistory(page) {
      try {
        const tbody = document.getElementById("payoutHistoryBody");
        const pagControls = document.getElementById("paginationControls");
        
        const res = await fetch(`/seller/payouts/history?page=${page}&limit=10`);
        const data = await res.json();
        
        tbody.innerHTML = ""; 

        if(data.success && data.payouts && data.payouts.length > 0) {
          data.payouts.forEach(pay => {
            const dateStr = new Date(pay.createdAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' });
            tbody.innerHTML += `
                <tr>
                    <td><span class="text-muted small">${dateStr}</span></td>
                    <td class="fw-bold">₹${pay.amount}</td>
                    <td><span class="badge-status ${pay.status}">${pay.status}</span></td>
                    <td class="small text-muted">${pay.adminNote || '-'}</td>
                </tr>`;
          });

          currentPage = data.currentPage;
          totalPages = data.totalPages;
          document.getElementById("pageInfo").innerText = `Page ${currentPage} of ${totalPages}`;
          document.getElementById("prevBtn").disabled = (currentPage === 1);
          document.getElementById("nextBtn").disabled = (currentPage === totalPages);
          pagControls.style.display = "flex";
        } else {
          tbody.innerHTML = `<tr><td colspan="4" class="text-center py-5 text-muted">No payout requests found</td></tr>`;
          pagControls.style.display = "none";
        }
      } catch(err) { console.error(err); }
    }

    async function changePage(offset) {
      const targetPage = currentPage + offset;
      if(targetPage >= 1 && targetPage <= totalPages) {
        await fetchHistory(targetPage);
      }
    }

    async function requestPayout() {
      const amount = document.getElementById("payoutAmount").value;
      const btn = document.querySelector(".btn-withdraw");

      if (!amount || amount < 100) {
        showToast("Minimum withdrawal is ₹100", "#ef4444");
        return;
      }

      try {
        btn.disabled = true;
        btn.innerHTML = "<span class='spinner-border spinner-border-sm'></span> Sending...";

        const res = await fetch("/seller/payouts/request", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ amount: amount })
        });

        const data = await res.json();

        if (data.success) {
          showToast("Payout Request Sent!", "#10b981");
          document.getElementById("payoutAmount").value = "";
          await fetchWalletData();
          await fetchHistory(1);
        } else {
          showToast(data.message, "#ef4444");
        }
      } catch (err) {
        showToast("Request failed", "#ef4444");
      } finally {
        btn.disabled = false;
        btn.innerHTML = "<i class='bx bx-right-arrow-alt'></i> Withdraw Now";
      }
    }

    function showToast(text, color) {
      Toastify({ text: text, style: { background: color }, duration: 3000 }).showToast();
    }
  </script>
</body>
</html>