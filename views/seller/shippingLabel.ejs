<!-- views/seller/shippingLabel.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Shipping Label - BharatMkt</title>
    <style>
        body { font-family: 'Arial', sans-serif; background: #333; margin: 0; padding: 0; }
        
        /* Standard 4x6 Inch Label (101.6mm x 152.4mm) */
        .marca-container {
            width: 101.6mm; 
            min-height: 152.4mm;
            background: #fff; 
            margin: 20px auto; 
            border: 1px solid #000;
            display: flex; 
            flex-direction: column;
            color: #000;
            box-sizing: border-box;
        }

        /* Top Header */
        .top-section { display: flex; border-bottom: 2px solid #000; height: 50px; }
        .logo-area { flex: 2; padding: 10px; font-size: 24px; font-weight: 900; border-right: 2px solid #000; display: flex; align-items: center; }
        .carrier-area { flex: 1; padding: 5px; font-size: 11px; font-weight: bold; text-align: center; line-height: 1.2; }

        /* Payment Banner (Fixed Clipping) */
        .payment-banner {
            border-bottom: 2px solid #000;
            text-align: center;
            padding: 10px 0;
            font-size: 32px;
            font-weight: 900;
            letter-spacing: 2px;
            background: <%= order.paymentMethod === 'COD' ? '#000' : '#fff' %>;
            color: <%= order.paymentMethod === 'COD' ? '#fff' : '#000' %>;
        }

        /* Essential Grid Info */
        .grid-info { display: flex; border-bottom: 2px solid #000; font-size: 12px; }
        .grid-cell { flex: 1; border-right: 2px solid #000; padding: 8px; }
        .grid-cell:last-child { border-right: none; }
        .label-tiny { font-size: 8px; font-weight: bold; text-transform: uppercase; color: #444; margin-bottom: 3px; }

        /* Address Sections */
        .address-box { border-bottom: 1px solid #000; padding: 10px; }
        .name-bold { font-size: 16px; font-weight: 900; margin-bottom: 4px; }
        .addr-text { font-size: 13px; line-height: 1.3; font-weight: 600; }

        /* Scannable Area (QR + Barcode) */
        .scannable-section { 
            border-bottom: 2px solid #000; 
            display: flex; 
            align-items: center; 
            padding: 15px 10px;
        }
        .qr-box { width: 80px; height: 80px; border: 1px solid #eee; padding: 2px; }
        .barcode-box { flex-grow: 1; text-align: center; padding-left: 10px; }
        .barcode-img { width: 100%; height: 60px; object-fit: contain; }

        /* Item Table */
        .items-table { border-bottom: 2px solid #000; width: 100%; border-collapse: collapse; }
        .items-table th, .items-table td { border: 1px solid #000; font-size: 10px; padding: 5px; text-align: left; }
        .items-table th { background: #f0f0f0; }

        .seller-tax-info { padding: 8px; font-size: 9px; line-height: 1.4; background: #fafafa; border-bottom: 1px solid #000; }
        .footer-text { text-align: center; font-size: 8px; padding: 5px; font-weight: bold; }

        @media print {
            body { background: transparent; padding: 0; }
            .marca-container { margin: 0; border: none; width: 101.6mm; height: 152.4mm; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>

    <div class="marca-container">
        <!-- Section 1: Header -->
        <div class="top-section">
            <div class="logo-area">BharatMkt</div>
            <div class="carrier-area">
                SURFACE EXPRESS<br>
                <span style="font-size: 14px;">STD-LOCAL</span>
            </div>
        </div>

        <!-- Section 2: Payment Mode -->
        <div class="payment-banner">
            <%= order.paymentMethod === 'COD' ? 'COLLECT ₹' + order.totalAmount : 'PREPAID' %>
        </div>

        <!-- Section 3: Routing & ID -->
        <div class="grid-info">
            <div class="grid-item grid-cell">
                <div class="label-tiny">Order Date</div>
                <strong><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></strong>
            </div>
            <div class="grid-item grid-cell">
                <div class="label-tiny">Order ID</div>
                <strong>#<%= order._id.toString().slice(-12).toUpperCase() %></strong>
            </div>
        </div>

        <!-- Section 4: Shipping Address (Ship To) -->
        <div class="address-box">
            <div class="label-tiny">Ship To:</div>
            <div class="name-bold"><%= order.shippingAddress.fullName %></div>
            <div class="addr-text">
                <%= order.shippingAddress.addressLine1 %>, <%= order.shippingAddress.addressLine2 %><br>
                <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %><br>
                <strong>PIN: <%= order.shippingAddress.postalCode %></strong><br>
                Ph: <%= order.shippingAddress.phone %>
            </div>
        </div>

        <!-- Section 5: Barcode & QR (No Fonts, Just Reliable Images) -->
        <div class="scannable-section">
            <!-- Order ID QR Code -->
            <img class="qr-box" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= order._id %>" alt="QR">
            
            <div class="barcode-box">
                <!-- Real Scannable Barcode Image -->
                <img class="barcode-img" src="https://bwipjs-api.metafloor.com/?bcid=code128&text=<%= order._id.toString().slice(-12).toUpperCase() %>&scale=2&rotate=N&includetext" alt="Barcode">
                <div style="font-size: 10px; font-weight: bold; margin-top: 5px;">Tracking No: BM-<%= order._id.toString().slice(-12).toUpperCase() %></div>
            </div>
        </div>

        <!-- Section 6: Itemized Details -->
        <table class="items-table">
            <thead>
                <tr>
                    <th>SKU/Product Name</th>
                    <th>HSN</th>
                    <th>Qty</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                <% order.items.forEach(item => { %>
                <tr>
                    <td><%= item.title.substring(0, 40) %></td>
                    <td>0803</td> <!-- Default Fruit HSN -->
                    <td><%= item.quantity %></td>
                    <td>₹<%= item.price %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <!-- Section 7: Seller Info -->
        <div class="seller-info seller-tax-info">
            <strong>Sold By:</strong> <%= profile.businessName %> | GST: <%= profile.gstNumber %><br>
            <strong>Ship From:</strong> <%= profile.address %>, <%= profile.city %>, <%= profile.state %> - <%= profile.pincode %><br>
            <strong>Invoice No:</strong> BM/INV/<%= order._id.toString().slice(-6).toUpperCase() %>
        </div>

        <div class="footer-text">
            * This is a computer generated label, no signature required. *
        </div>
    </div>

    <!-- Print Button -->
    <div class="no-print" style="text-align: center; margin-bottom: 50px;">
        <button onclick="window.print()" style="padding: 15px 50px; background: #000; color: #fff; border: none; font-weight: bold; border-radius: 4px; cursor: pointer; font-size: 16px;">
            PRINT   (SHIPPING LABEL)
        </button>
    </div>

</body>
</html>