<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Management | Seller Panel</title>
  
  <!-- Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #10b981;
      --primary-dark: #059669;
      --bg-body: #f3f4f6;
      --sidebar-width: 260px;
      --transition: all 0.3s ease;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-body);
      margin: 0;
    }

    /* Sidebar Styling */
    .sidebar {
      width: var(--sidebar-width);
      background: #1f2937;
      color: #fff;
      position: fixed;
      height: 100vh;
      padding-top: 20px;
      transition: var(--transition);
      z-index: 1000;
    }
    .nav-item {
      display: flex;
      align-items: center;
      padding: 12px 20px;
      color: #d1d5db;
      text-decoration: none;
      transition: 0.3s;
    }
    .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.1); color: #fff; }
    .nav-item i { margin-right: 12px; font-size: 20px; }

    /* Main Content */
    .main-content {
      margin-left: var(--sidebar-width);
      padding: 40px;
      transition: var(--transition);
    }

    /* Mobile Header */
    .mobile-header {
      display: none;
      background: #fff;
      padding: 15px 20px;
      border-bottom: 1px solid #e5e7eb;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 900;
    }

    /* Card & Table */
    .inventory-card {
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
      overflow: hidden;
    }

    .table thead th {
      background: #f9fafb;
      color: #6b7280;
      font-size: 12px;
      text-transform: uppercase;
      font-weight: 600;
      letter-spacing: 0.5px;
      border-top: none;
      padding: 16px;
    }

    .table tbody td {
      padding: 16px;
      vertical-align: middle;
      font-size: 14px;
    }

    /* Status Badges */
    .badge-stock {
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
    }
    .bg-low { background: #fee2e2; color: #dc2626; }
    .bg-ok { background: #d1fae5; color: #059669; }

    .btn-action {
      padding: 6px 12px;
      font-size: 13px;
      font-weight: 600;
      border-radius: 8px;
      text-decoration: none;
      transition: 0.2s;
    }
    
    .btn-restock { background: #eff6ff; color: #2563eb; }
    .btn-restock:hover { background: #2563eb; color: white; }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 999;
    }

    /* Responsive */
    @media (max-width: 991.98px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .main-content { margin-left: 0; padding: 20px; }
      .mobile-header { display: flex; }
      .sidebar-overlay.active { display: block; }
    }
  </style>
</head>
<body>

  <!-- Overlay for Mobile -->
  <div class="sidebar-overlay" id="overlay" onclick="toggleSidebar()"></div>

  <!-- Mobile Header -->
  <header class="mobile-header">
    <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
    <button class="btn btn-dark" onclick="toggleSidebar()">
        <i class='bx bx-menu-alt-left fs-3'></i>
    </button>
  </header>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="px-4 mb-4 d-flex justify-content-between align-items-center">
        <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
        <button class="btn text-white d-lg-none" onclick="toggleSidebar()"><i class='bx bx-x fs-3'></i></button>
    </div>
    <nav>
      <a href="/seller/dashboard" class="nav-item"><i class='bx bxs-dashboard'></i> Dashboard</a>
      <a href="/seller/daily-orders" class="nav-item"><i class='bx bxs-truck'></i> Today's Orders</a>
      <a href="/sellers/returns" class="nav-item"><i class='bx bx-undo'></i> Return Requests</a>
      <a href="/seller/inventory" class="nav-item active"><i class='bx bxs-box'></i> Inventory</a>
      <a href="/seller/wallet" class="nav-item"><i class='bx bxs-wallet'></i> Wallet</a>
      <a href="/seller/slots/history" class="nav-item"><i class='bx bxs-time-five'></i> Slot History</a>
      <a href="/seller/auth/logout" class="nav-item text-danger mt-5"><i class='bx bx-log-out'></i> Logout</a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Product Inventory</h2>
            <p class="text-muted small">Manage your stock levels and product visibility.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a href="/seller/inventory/add" class="btn btn-outline-success btn-sm">
                <i class='bx bx-plus'></i> Add Stock
            </a>
            <a href="/seller/add" class="btn btn-success btn-sm">
                <i class='bx bx-package'></i> New Product
            </a>
        </div>
    </div>

    <div class="inventory-card">
      <div class="table-responsive">
        <% if(inventory.length === 0){ %>
            <div class="text-center py-5">
                <i class='bx bx-archive-out fs-1 text-muted'></i>
                <p class="mt-2 text-muted">No inventory found. Start by adding stock.</p>
                <a href="/seller/inventory/add" class="btn btn-primary btn-sm mt-2">Add Stock Now</a>
            </div>
        <% } else { %>
            <table class="table table-hover mb-0">
              <thead>
                <tr>
                  <th>Product Details</th>
                  <th>Total Stock</th>
                  <th>Sold</th>
                  <th>Remaining</th>
                  <th>Status</th>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% inventory.forEach(item => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                        <!-- Placeholder for Image if you have it in your schema -->
                        <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class='bx bx-package text-muted'></i>
                        </div>
                        <div>
                            <span class="fw-bold d-block text-dark"><%= item.product.title %></span>
                            <span class="text-muted" style="font-size: 11px;">ID: <%= item._id.toString().slice(-6).toUpperCase() %></span>
                        </div>
                    </div>
                  </td>
                  <td><span class="fw-medium"><%= item.totalStock %></span></td>
                  <td><span class="text-muted"><%= item.sold %></span></td>
                  <td><span class="fw-bold"><%= item.remaining %></span></td>
                  <td>
                    <% if(item.remaining < 5) { %>
                        <span class="badge-stock bg-low">Low Stock</span>
                    <% } else { %>
                        <span class="badge-stock bg-ok">Healthy</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <a href="/seller/inventory/restock/<%= item._id %>" class="btn-action btn-restock">
                        <i class='bx bx-refresh'></i> Restock
                    </a>
                    <a href="/seller/product/edit/<%= item.product._id %>" class="btn-action text-muted ms-2">
                        <i class='bx bx-edit-alt'></i>
                    </a>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
        <% } %>
      </div>
    </div>
  </main>

  <script>
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('overlay').classList.toggle('active');
    }
  </script>
</body>
</html>