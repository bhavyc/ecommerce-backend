<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Product | Seller Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root { 
        --primary: #10b981; 
        --primary-dark: #059669;
        --bg-body: #f3f4f6; 
        --sidebar-width: 260px; 
    }
    
    body { font-family: 'Inter', sans-serif; background-color: var(--bg-body); margin: 0; }
    
    /* Sidebar styling */
    .sidebar { 
        width: var(--sidebar-width); 
        background: #1f2937; 
        color: #fff; 
        position: fixed; 
        height: 100vh; 
        padding-top: 20px; 
        transition: all 0.3s;
        z-index: 1000;
    }
    .nav-item { display: flex; align-items: center; padding: 12px 20px; color: #d1d5db; text-decoration: none; transition: 0.3s; }
    .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.1); color: #fff; }
    .nav-item i { margin-right: 12px; font-size: 20px; }

    /* Main Content */
    .main-content { 
        margin-left: var(--sidebar-width); 
        padding: 40px; 
        transition: all 0.3s;
    }

    /* Mobile Header */
    .mobile-header {
        display: none;
        background: #fff;
        padding: 15px 20px;
        border-bottom: 1px solid #e5e7eb;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 900;
    }

    /* Form Container */
    .form-card {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    label { font-weight: 600; color: #374151; font-size: 14px; margin-bottom: 6px; }
    
    .form-control, .form-select {
        border-radius: 8px;
        padding: 12px;
        border: 1px solid #d1d5db;
        margin-bottom: 20px;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }

    /* File Upload Area */
    .file-upload-wrapper {
        border: 2px dashed #d1d5db;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        background: #f9fafb;
        cursor: pointer;
        transition: 0.3s;
        margin-bottom: 20px;
    }
    .file-upload-wrapper:hover { border-color: var(--primary); background: #f0fdf4; }
    .file-upload-wrapper i { font-size: 40px; color: #9ca3af; margin-bottom: 10px; }
    
    #imagePreview { 
        width: 100%; 
        max-height: 250px; 
        object-fit: contain; 
        margin-top: 15px; 
        display: none; 
        border-radius: 8px;
    }

    .btn-submit {
        background: var(--primary);
        color: white;
        border: none;
        padding: 14px;
        font-weight: 600;
        border-radius: 8px;
        width: 100%;
        transition: 0.3s;
    }
    .btn-submit:hover { background: var(--primary-dark); }

    .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 999;
    }

    /* RESPONSIVE */
    @media (max-width: 991.98px) {
        .sidebar { margin-left: calc(-1 * var(--sidebar-width)); }
        .sidebar.active { margin-left: 0; }
        .main-content { margin-left: 0; padding: 20px; }
        .mobile-header { display: flex; }
        .sidebar-overlay.active { display: block; }
    }

    @media (max-width: 576px) {
        .form-card { padding: 20px; }
        .input-group-responsive { flex-direction: column; }
    }
  </style>
</head>
<body>

  <div class="sidebar-overlay" id="overlay" onclick="toggleSidebar()"></div>

  <!-- Mobile Top Bar -->
  <header class="mobile-header">
    <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
    <button class="btn btn-dark" onclick="toggleSidebar()">
        <i class='bx bx-menu-alt-left fs-3'></i>
    </button>
  </header>

  <aside class="sidebar" id="sidebar">
    <div class="px-4 mb-4 d-flex justify-content-between align-items-center">
        <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
        <button class="btn text-white d-lg-none" onclick="toggleSidebar()"><i class='bx bx-x fs-3'></i></button>
    </div>
    <nav>
      <a href="/seller/dashboard" class="nav-item"><i class='bx bxs-dashboard'></i> Dashboard</a>
      <a href="/seller/slots/history" class="nav-item"><i class='bx bxs-time-five'></i> Slot History</a>
      <a href="/seller/inventory" class="nav-item active"><i class='bx bxs-box'></i> Inventory</a>
      <a href="/seller/wallet" class="nav-item"><i class='bx bxs-wallet'></i> Wallet</a>
      <a href="/seller/auth/logout" class="nav-item text-danger mt-5"><i class='bx bx-log-out'></i> Logout</a>
    </nav>
  </aside>

  <main class="main-content">
    <div class="mb-4">
        <a href="/seller/inventory" class="text-decoration-none text-muted small"><i class='bx bx-arrow-back'></i> Back to Inventory</a>
        <h2 class="fw-bold mt-2">Add New Product</h2>
    </div>

    <div class="form-card">
      <form action="/seller/add" method="POST" enctype="multipart/form-data">
        
        <label for="title">Product Title</label>
        <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Alphonso Mangoes" required />

        <label for="category">Category</label>
        <select id="category" name="category" class="form-select" required>
          <option value="" disabled selected>Choose a category</option>
          <option value="Fruits">Fruits</option>
          <option value="Vegetables">Vegetables</option>
          <option value="Groceries">Groceries</option>
          <option value="Electronics">Electronics</option>
          <option value="Fashion">Fashion</option>
        </select>

        <label for="description">Description</label>
        <textarea id="description" name="description" class="form-control" rows="3" placeholder="Describe your product..."></textarea>

        <div class="row gx-3">
          <div class="col-6">
            <label for="price">Price (₹)</label>
            <input type="number" id="price" name="price" class="form-control" placeholder="0.00" required />
          </div>
          <!-- <div class="col-6">
            <label for="discount">Discount (%)</label>
            <input type="number" id="discount" name="discount" class="form-control" value="0" />
          </div> -->
        </div>

        <label>Product Image</label>
        <div class="file-upload-wrapper" onclick="document.getElementById('imageInput').click()">
          <i class='bx bx-cloud-upload'></i>
          <p class="mb-0 text-muted" id="fileLabel">Click to upload product image</p>
          <input type="file" id="imageInput" name="image" accept="image/*" style="display: none;" required onchange="previewImage(event)" />
          <img id="imagePreview" alt="Preview" />
        </div>

        <button type="submit" class="btn-submit">🚀 List Product</button>
      </form>
    </div>
  </main>

  <script>
    function toggleSidebar() {
        document.getElementById("sidebar").classList.toggle("active");
        document.getElementById("overlay").classList.toggle("active");
    }

    function previewImage(event) {
      const reader = new FileReader();
      const imagePreview = document.getElementById('imagePreview');
      const fileLabel = document.getElementById('fileLabel');

      reader.onload = function() {
        if (reader.readyState === 2) {
          imagePreview.src = reader.result;
          imagePreview.style.display = 'block';
          fileLabel.innerText = "Image Selected (Click to change)";
        }
      }
      reader.readAsDataURL(event.target.files[0]);
    }
  </script>
</body>
</html>