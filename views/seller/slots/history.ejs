<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Slot History | Seller Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <style>
    :root { --primary: #10b981; --bg-body: #f3f4f6; }
    body { font-family: 'Inter', sans-serif; background-color: var(--bg-body); }
    
    /* Sidebar matching your dashboard */
    .sidebar { width: 260px; background: #1f2937; color: #fff; position: fixed; height: 100vh; padding-top: 20px; }
    .nav-item { display: flex; align-items: center; padding: 12px 20px; color: #d1d5db; text-decoration: none; transition: 0.3s; }
    .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.1); color: #fff; }
    .nav-item i { margin-right: 12px; font-size: 20px; }

    .main-content { margin-left: 260px; padding: 40px; }
    .table-container { background: white; border-radius: 16px; padding: 25px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    
    .badge-type { padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: bold; }
    .bg-drop { background: #fee2e2; color: #dc2626; } /* Red for Drop */
    .bg-deal { background: #dbeafe; color: #2563eb; } /* Blue for Deal */
    
    .product-img { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; margin-right: 10px; }
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="px-4 mb-4"><h4 class="text-success fw-bold">SellerPanel</h4></div>
    <nav>
      <a href="/seller/dashboard" class="nav-item"><i class='bx bxs-dashboard'></i> Dashboard</a>
      <a href="/seller/slots/history" class="nav-item active"><i class='bx bxs-time-five'></i> Slot History</a>
      <a href="/seller/inventory" class="nav-item"><i class='bx bxs-box'></i> Inventory</a>
      <a href="/seller/wallet" class="nav-item"><i class='bx bxs-wallet'></i> Wallet</a>
      <a href="/seller/auth/logout" class="nav-item text-danger mt-5"><i class='bx bx-log-out'></i> Logout</a>
    </nav>
  </aside>

  <main class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">My Booked Slots</h2>
        <a href="/seller/buy-slot" class="btn btn-success btn-sm"><i class='bx bx-plus'></i> Book New Slot</a>
    </div>

    <div class="table-container">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Date</th>
              <th>Product</th>
              <th>Type</th>
              <th>Discount</th>
              <th>Paid Amount</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="slotTableBody"></tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <div class="d-flex justify-content-between align-items-center mt-4">
        <div id="paginationInfo" class="small text-muted"></div>
        <nav><ul class="pagination pagination-sm mb-0" id="paginationButtons"></ul></nav>
      </div>
    </div>
  </main>

  <script>
    async function loadSlots(page = 1) {
      const tbody = document.getElementById("slotTableBody");
      tbody.innerHTML = `<tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-success"></div></td></tr>`;

      try {
        const res = await fetch(`/seller/slots/data?page=${page}`);
        const data = await res.json();

        tbody.innerHTML = "";
        if (data.success && data.slots.length > 0) {
          data.slots.forEach(slot => {
            const date = new Date(slot.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
            const typeClass = slot.type === 'DROP' ? 'bg-drop' : 'bg-deal';
            
            tbody.innerHTML += `
              <tr>
                <td>${date}</td>
                <td>
                  <img src="${slot.product?.image || '/uploads/default.png'}" class="product-img">
                  <span class="fw-bold">${slot.product?.title || 'Deleted Product'}</span>
                </td>
                <td><span class="badge-type ${typeClass}">${slot.type}</span></td>
                <td class="fw-bold text-danger">${slot.discount}% Off</td>
                <td class="fw-bold">₹${slot.amountPaid}</td>
                <td><span class="text-success small fw-bold"><i class='bx bxs-check-circle'></i> Processed</span></td>
              </tr>`;
          });
          renderPagination(data.pagination);
        } else {
          tbody.innerHTML = `<tr><td colspan="6" class="text-center py-5 text-muted">No paid slots found.</td></tr>`;
        }
      } catch (err) { console.error(err); }
    }

    function renderPagination(pg) {
      const container = document.getElementById("paginationButtons");
      document.getElementById("paginationInfo").innerText = `Page ${pg.currentPage} of ${pg.totalPages}`;
      let html = "";
      html += `<li class="page-item ${pg.currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadSlots(${pg.currentPage - 1})">Prev</a></li>`;
      for(let i=1; i <= pg.totalPages; i++) {
        html += `<li class="page-item ${i === pg.currentPage ? 'active' : ''}"><a class="page-link" href="#" onclick="loadSlots(${i})">${i}</a></li>`;
      }
      html += `<li class="page-item ${pg.currentPage === pg.totalPages ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadSlots(${pg.currentPage + 1})">Next</a></li>`;
      container.innerHTML = html;
    }

    document.addEventListener("DOMContentLoaded", () => loadSlots(1));
  </script>
</body>
</html>