<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Slot History | Seller Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
  <style>
    :root { --primary: #10b981; --bg-body: #f3f4f6; --sidebar-width: 260px; }
    body { font-family: 'Inter', sans-serif; background-color: var(--bg-body); margin: 0; }
    
    /* Sidebar styling */
    .sidebar { 
        width: var(--sidebar-width); 
        background: #1f2937; 
        color: #fff; 
        position: fixed; 
        height: 100vh; 
        padding-top: 20px; 
        transition: all 0.3s;
        z-index: 1000;
    }
    .nav-item { display: flex; align-items: center; padding: 12px 20px; color: #d1d5db; text-decoration: none; transition: 0.3s; }
    .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.1); color: #fff; }
    .nav-item i { margin-right: 12px; font-size: 20px; }

    /* Main Content Styling */
    .main-content { 
        margin-left: var(--sidebar-width); 
        padding: 40px; 
        transition: all 0.3s;
    }

    /* Mobile Header (Visible only on small screens) */
    .mobile-header {
        display: none;
        background: #fff;
        padding: 15px 20px;
        border-bottom: 1px solid #e5e7eb;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 900;
    }

    .table-container { background: white; border-radius: 16px; padding: 25px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    
    .badge-type { padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: bold; white-space: nowrap; }
    .bg-drop { background: #fee2e2; color: #dc2626; } 
    .bg-deal { background: #dbeafe; color: #2563eb; } 
    
    .product-img { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; margin-right: 10px; }

    /* Overlay for mobile when sidebar is open */
    .sidebar-overlay {
        display: none;
        position: fixed;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 999;
    }

    /* RESPONSIVE BREAKPOINTS */
    @media (max-width: 991.98px) {
        .sidebar { margin-left: calc(-1 * var(--sidebar-width)); }
        .sidebar.active { margin-left: 0; }
        .main-content { margin-left: 0; padding: 20px; }
        .mobile-header { display: flex; }
        .sidebar-overlay.active { display: block; }
        
        .table-container { padding: 15px; }
        .fw-bold { font-size: 14px; }
    }

    @media (max-width: 576px) {
        .main-content { padding: 15px; }
        h2 { font-size: 1.25rem; }
        .btn-sm { padding: 8px 12px; font-size: 12px; }
    }
  </style>
</head>
<body>

  <!-- Mobile Overlay -->
  <div class="sidebar-overlay" id="overlay" onclick="toggleSidebar()"></div>

  <!-- Mobile Top Bar -->
  <header class="mobile-header">
    <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
    <button class="btn btn-dark" onclick="toggleSidebar()">
        <i class='bx bx-menu-alt-left fs-3'></i>
    </button>
  </header>

  <aside class="sidebar" id="sidebar">
    <div class="px-4 mb-4 d-flex justify-content-between align-items-center">
        <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
        <!-- Close btn for mobile -->
        <button class="btn text-white d-lg-none" onclick="toggleSidebar()"><i class='bx bx-x fs-3'></i></button>
    </div>
    <nav>
      <a href="/seller/dashboard" class="nav-item"><i class='bx bxs-dashboard'></i> Dashboard</a>
      <a href="/seller/slots/history" class="nav-item active"><i class='bx bxs-time-five'></i> Slot History</a>
      <a href="/seller/inventory" class="nav-item"><i class='bx bxs-box'></i> Inventory</a>
      <a href="/seller/wallet" class="nav-item"><i class='bx bxs-wallet'></i> Wallet</a>
      <a href="/seller/auth/logout" class="nav-item text-danger mt-5"><i class='bx bx-log-out'></i> Logout</a>
    </nav>
  </aside>

  <main class="main-content">
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-3 mb-md-0">My Booked Slots</h2>
        <a href="/seller/buy-slot" class="btn btn-success btn-sm"><i class='bx bx-plus'></i> Book New Slot</a>
    </div>

    <div class="table-container">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr class="text-nowrap">
              <th>Date</th>
              <th>Product</th>
              <th>Type</th>
              <th>Discount</th>
              <th>Paid</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="slotTableBody">
            <!-- Data will be injected here -->
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 gap-3">
        <div id="paginationInfo" class="small text-muted"></div>
        <nav><ul class="pagination pagination-sm mb-0" id="paginationButtons"></ul></nav>
      </div>
    </div>
  </main>

  <script>
    // Sidebar Toggle Function
    function toggleSidebar() {
        document.getElementById("sidebar").classList.toggle("active");
        document.getElementById("overlay").classList.toggle("active");
    }

    async function loadSlots(page = 1) {
      const tbody = document.getElementById("slotTableBody");
      tbody.innerHTML = `<tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-success"></div></td></tr>`;

      try {
        const res = await fetch(`/seller/slots/data?page=${page}`);
        const data = await res.json();

        tbody.innerHTML = "";
        if (data.success && data.slots.length > 0) {
          data.slots.forEach(slot => {
            const date = new Date(slot.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' });
            const typeClass = slot.type === 'DROP' ? 'bg-drop' : 'bg-deal';
            
            tbody.innerHTML += `
              <tr>
                <td class="text-nowrap">${date}</td>
                <td>
                  <div class="d-flex align-items-center">
                    <img src="${slot.product?.image || '/uploads/default.png'}" class="product-img">
                    <span class="fw-bold text-truncate" style="max-width: 150px;">${slot.product?.title || 'Deleted Product'}</span>
                  </div>
                </td>
                <td><span class="badge-type ${typeClass}">${slot.type}</span></td>
                <td class="fw-bold text-danger text-nowrap">${slot.discount}% Off</td>
                <td class="fw-bold text-nowrap">₹${slot.amountPaid}</td>
                <td><span class="text-success small fw-bold"><i class='bx bxs-check-circle'></i></span></td>
              </tr>`;
          });
          renderPagination(data.pagination);
        } else {
          tbody.innerHTML = `<tr><td colspan="6" class="text-center py-5 text-muted">No paid slots found.</td></tr>`;
        }
      } catch (err) { 
          console.error(err); 
          tbody.innerHTML = `<tr><td colspan="6" class="text-center py-5 text-danger">Failed to load data.</td></tr>`;
      }
    }

    function renderPagination(pg) {
      const container = document.getElementById("paginationButtons");
      document.getElementById("paginationInfo").innerText = `Page ${pg.currentPage} of ${pg.totalPages}`;
      let html = "";
      html += `<li class="page-item ${pg.currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadSlots(${pg.currentPage - 1})">Prev</a></li>`;
      
      // Show limited pages on mobile
      for(let i=1; i <= pg.totalPages; i++) {
        if(pg.totalPages > 5 && (i < pg.currentPage - 1 || i > pg.currentPage + 1)) continue; 
        html += `<li class="page-item ${i === pg.currentPage ? 'active' : ''}"><a class="page-link" href="#" onclick="loadSlots(${i})">${i}</a></li>`;
      }

      html += `<li class="page-item ${pg.currentPage === pg.totalPages ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadSlots(${pg.currentPage + 1})">Next</a></li>`;
      container.innerHTML = html;
    }

    document.addEventListener("DOMContentLoaded", () => loadSlots(1));
  </script>
</body>
</html>