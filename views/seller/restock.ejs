<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restock Product | Seller Panel</title>
  
  <!-- Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

  <style>
    :root {
      --primary: #10b981;
      --primary-dark: #059669;
      --bg-body: #f3f4f6;
      --sidebar-width: 260px;
      --transition: all 0.3s ease;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-body);
      margin: 0;
    }

    /* Sidebar Styling */
    .sidebar {
      width: var(--sidebar-width);
      background: #1f2937;
      color: #fff;
      position: fixed;
      height: 100vh;
      padding-top: 20px;
      transition: var(--transition);
      z-index: 1000;
    }
    .nav-item {
      display: flex;
      align-items: center;
      padding: 12px 20px;
      color: #d1d5db;
      text-decoration: none;
      transition: 0.3s;
    }
    .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.1); color: #fff; }
    .nav-item i { margin-right: 12px; font-size: 20px; }

    /* Main Content */
    .main-content {
      margin-left: var(--sidebar-width);
      padding: 40px;
      transition: var(--transition);
    }

    /* Mobile Header */
    .mobile-header {
      display: none;
      background: #fff;
      padding: 15px 20px;
      border-bottom: 1px solid #e5e7eb;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 900;
    }

    /* Form Card */
    .restock-card {
      background: white;
      padding: 30px;
      border-radius: 16px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
      max-width: 500px;
      margin: 0 auto;
    }

    .current-stock-info {
        background: #f0fdf4;
        border: 1px solid #d1fae5;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 25px;
        text-align: center;
    }

    .form-label { font-weight: 600; color: #374151; margin-bottom: 8px; }
    
    .form-control {
        border-radius: 8px;
        padding: 12px;
        border: 1px solid #d1d5db;
        margin-bottom: 20px;
    }

    .btn-submit {
        background: var(--primary);
        color: white;
        border: none;
        padding: 14px;
        font-weight: 700;
        border-radius: 8px;
        width: 100%;
        transition: 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .btn-submit:hover { background: var(--primary-dark); }

    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 999;
    }

    /* Responsive */
    @media (max-width: 991.98px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.active { transform: translateX(0); }
      .main-content { margin-left: 0; padding: 20px; }
      .mobile-header { display: flex; }
      .sidebar-overlay.active { display: block; }
    }
  </style>
</head>
<body>

  <!-- Overlay for Mobile -->
  <div class="sidebar-overlay" id="overlay" onclick="toggleSidebar()"></div>

  <!-- Mobile Top Bar -->
  <header class="mobile-header">
    <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
    <button class="btn btn-dark" onclick="toggleSidebar()">
        <i class='bx bx-menu-alt-left fs-3'></i>
    </button>
  </header>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="px-4 mb-4 d-flex justify-content-between align-items-center">
        <h4 class="text-success fw-bold mb-0">SellerPanel</h4>
        <button class="btn text-white d-lg-none" onclick="toggleSidebar()"><i class='bx bx-x fs-3'></i></button>
    </div>
    <nav>
      <a href="/seller/dashboard" class="nav-item"><i class='bx bxs-dashboard'></i> Dashboard</a>
      <a href="/seller/daily-orders" class="nav-item"><i class='bx bxs-truck'></i> Today's Orders</a>
      <a href="/sellers/returns" class="nav-item"><i class='bx bx-undo'></i> Return Requests</a>
      <a href="/seller/inventory" class="nav-item active"><i class='bx bxs-box'></i> Inventory</a>
      <a href="/seller/wallet" class="nav-item"><i class='bx bxs-wallet'></i> Wallet</a>
      <a href="/seller/auth/logout" class="nav-item text-danger mt-5"><i class='bx bx-log-out'></i> Logout</a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    <div class="mb-4">
        <a href="/seller/inventory" class="text-decoration-none text-muted small d-flex align-items-center">
            <i class='bx bx-left-arrow-alt fs-5 me-1'></i> Back to Inventory
        </a>
        <h2 class="fw-bold mt-2">Restock Product</h2>
    </div>

    <div class="restock-card">
      <div class="current-stock-info">
          <p class="text-muted small mb-1">Product Name</p>
          <h5 class="fw-bold mb-2"><%= inventory.product.title %></h5>
          <span class="badge bg-white text-success border border-success-subtle px-3 py-2 rounded-pill">
              Current Stock: <strong><%= inventory.remaining %></strong>
          </span>
      </div>

      <form action="/seller/inventory/restock/<%= inventory._id %>" method="POST">
        <div class="mb-3">
            <label class="form-label">Quantity to Add</label>
            <input type="number" name="quantity" class="form-control" min="1" placeholder="e.g. 50" required autofocus />
        </div>

        <button type="submit" class="btn-submit">
            <i class='bx bx-plus-circle'></i> Update Stock Level
        </button>
      </form>
    </div>
  </main>

  <script>
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('overlay').classList.toggle('active');
    }
  </script>
</body>
</html>