<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Team Lobby - <%= group.deal.title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
  <style>
    body {
      background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', sans-serif;
    }
    .lobby-card {
      max-width: 600px;
      width: 100%;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      overflow: hidden;
      background: #fff;
    }
    .deal-header {
      background: linear-gradient(45deg, #651fff, #b388ff);
      color: white;
      padding: 30px;
      text-align: center;
      position: relative;
    }
    .deal-image {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 4px solid white;
      object-fit: cover;
      position: absolute;
      bottom: -50px;
      left: 50%;
      transform: translateX(-50%);
      background: #fff;
    }
    .card-body {
      padding: 60px 30px 30px; /* Top padding clears the image */
    }
    .price-tag {
      font-size: 1.5rem;
      font-weight: bold;
      color: #6200ea;
    }
    .original-price {
      text-decoration: line-through;
      color: #999;
      font-size: 1rem;
    }
    
    .member-list {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin: 20px 0;
    }
    .member-avatar {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      color: #555;
      border: 2px solid #fff;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      position: relative;
    }
    .member-avatar.joined {
      background: #00c853;
      color: white;
      border-color: #00c853;
    }
    .member-avatar.empty {
      border: 2px dashed #bbb;
      background: transparent;
      color: #bbb;
    }
    
    .status-badge {
      padding: 8px 20px;
      border-radius: 50px;
      font-weight: bold;
      text-transform: uppercase;
      font-size: 0.8rem;
    }
    .bg-open { background: #fff3cd; color: #856404; }
    .bg-completed { background: #d4edda; color: #155724; }
    .bg-expired { background: #f8d7da; color: #721c24; }

    .timer {
      font-size: 1.2rem;
      font-weight: bold;
      color: #d32f2f;
    }
  </style>
</head>
<body>

<div class="lobby-card animate__animated animate__fadeInUp">
  <!-- Header -->
  <div class="deal-header">
    <h3><%= group.deal.title %></h3>
    <p class="mb-0">Team Buying Lobby</p>
    <% if(group.deal.image) { %>
      <img src="<%= group.deal.image %>" class="deal-image shadow" alt="Product">
    <% } %>
  </div>

  <div class="card-body text-center">
    
    <!-- Price Info -->
    <div class="mb-3">
      <span class="original-price">₹<%= group.deal.price %></span>
      <span class="price-tag mx-2">₹<%= group.deal.groupPrice %></span>
      <span class="badge bg-danger rounded-pill">Team Deal</span>
    </div>

    <!-- Status & Timer -->
    <div class="mb-4">
      <% if (group.status === 'COMPLETED') { %>
        <span class="status-badge bg-completed">🎉 Deal Secured!</span>
        <p class="mt-2 text-success">The group is full. Your order is processing!</p>
      <% } else if (new Date() > group.expiresAt || group.status === 'EXPIRED') { %>
        <span class="status-badge bg-expired">❌ Expired</span>
        <p class="mt-2 text-muted">This group failed to fill in time.</p>
      <% } else { %>
        <span class="status-badge bg-open">⏳ Waiting for Members</span>
        <p class="mt-2">Ends in: <span class="timer" id="countdown">Loading...</span></p>
        
        <!-- Progress Bar -->
        <div class="progress mt-2" style="height: 8px;">
          <% let percent = (group.members.length / group.requiredSize) * 100; %>
          <div class="progress-bar bg-success" role="progressbar" style="width: <%= percent %>%"></div>
        </div>
        <small class="text-muted"><%= group.members.length %> of <%= group.requiredSize %> joined</small>
      <% } %>
    </div>

    <!-- Member Avatars -->
    <div class="member-list">
      <% for(let i=0; i < group.requiredSize; i++) { %>
        <% if (group.members[i]) { %>
          <!-- Joined Member -->
          <div class="member-avatar joined" title="<%= group.members[i].user.name %>">
             <%= group.members[i].user.name.charAt(0).toUpperCase() %>
          </div>
        <% } else { %>
          <!-- Empty Slot -->
          <div class="member-avatar empty">?</div>
        <% } %>
      <% } %>
    </div>

    <hr>

    <!-- 🟢 Logic: Is Current User Already in Group? -->
    <% const isMember = user && group.members.some(m => m.user._id.toString() === user._id.toString()); %>
    
    <% if (isMember) { %>
      <!-- User IS in the group -->
      <% if (group.status === 'OPEN') { %>
        <h5 class="mt-3">Invite your friends!</h5>
        <p class="text-muted small">Share this link to fill the remaining <%= slotsLeft %> spots.</p>
        
        <div class="input-group mb-3">
          <input type="text" class="form-control" value="<%= shareLink %>" id="shareInput" readonly>
          <button class="btn btn-primary" onclick="copyLink()">Copy Link</button>
        </div>
        <div id="copyMsg" class="text-success small" style="display:none;">Link Copied!</div>
      <% } else if (group.status === 'COMPLETED') { %>
        <a href="/order/history" class="btn btn-outline-success w-100">View Order Status</a>
      <% } %>

    <% } else { %>
      <!-- User is NOT in the group (Visitor) -->

      <% if (group.status === 'OPEN' && slotsLeft > 0) { %>
        <h5 class="text-start">Join this Team</h5>
        <p class="text-start small text-muted">Complete your purchase to secure the spot.</p>

        <form action="/group/join" method="POST" class="text-start">
          <input type="hidden" name="groupId" value="<%= group._id %>">
          
          <div class="mb-2">
            <input type="text" name="addressData[fullName]" class="form-control form-control-sm" placeholder="Full Name" required value="<%= user ? user.name : '' %>">
          </div>
          <div class="mb-2">
            <input type="text" name="addressData[addressLine1]" class="form-control form-control-sm" placeholder="Address" required>
          </div>
          <div class="row g-2 mb-2">
            <div class="col">
              <input type="text" name="addressData[city]" class="form-control form-control-sm" placeholder="City" required>
            </div>
            <div class="col">
              <input type="text" name="addressData[postalCode]" class="form-control form-control-sm" placeholder="Pincode" required>
            </div>
          </div>
          <div class="mb-3">
             <select name="paymentMethod" class="form-select form-select-sm">
                <option value="COD">Cash on Delivery</option>
                <option value="UPI">UPI / Online</option>
             </select>
          </div>

          <% if (!user) { %>
            <a href="/auth/login" class="btn btn-warning w-100">Login to Join</a>
          <% } else { %>
            <button type="submit" class="btn btn-success w-100 fw-bold">Pay ₹<%= group.deal.groupPrice %> & Join</button>
          <% } %>
        </form>

      <% } else { %>
        <div class="alert alert-secondary">
          Sorry, this group is closed or expired. <br>
          <a href="/api/deals" class="fw-bold">Start your own group here!</a>
        </div>
      <% } %>

    <% } %>

  </div>
</div>

<script>
  // 1. Copy Link Logic
  function copyLink() {
    const copyText = document.getElementById("shareInput");
    copyText.select();
    copyText.setSelectionRange(0, 99999); 
    navigator.clipboard.writeText(copyText.value);
    
    const msg = document.getElementById("copyMsg");
    msg.style.display = "block";
    setTimeout(() => msg.style.display = "none", 2000);
  }

  // 2. Countdown Logic
  const expiresAt = new Date("<%= group.expiresAt %>").getTime();

  const timerInterval = setInterval(function() {
    const now = new Date().getTime();
    const distance = expiresAt - now;

    if (distance < 0) {
      clearInterval(timerInterval);
      document.getElementById("countdown").innerHTML = "EXPIRED";
      document.getElementById("countdown").classList.add('text-muted');
      return;
    }

    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    document.getElementById("countdown").innerHTML = hours + "h " + minutes + "m " + seconds + "s ";
  }, 1000);
</script>

</body>
</html>