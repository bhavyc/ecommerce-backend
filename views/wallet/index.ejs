<!DOCTYPE html>
<html>
<head>
  <title>My Wallet</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
  <h2> My Wallet </h2>
  
  <div class="card bg-success text-white p-4 mb-4">
    <h3>Balance: ₹<%= user.walletBalance %></h3>
  </div>

  <!-- Add Money Form -->
  <form action="/wallet/add" method="POST" class="mb-4">
    <div class="input-group">
      <input type="number" name="amount" class="form-control" placeholder="Enter Amount (e.g. 500)" required>
      <button class="btn btn-primary">Add Money</button>
    </div>
  </form>

  <h4>History</h4>
  <ul class="list-group">
    <% transactions.forEach(t => { %>
      <li class="list-group-item d-flex justify-content-between">
        <span><%= t.description %></span>
        <span class="<%= t.type=='CREDIT'?'text-success':'text-danger' %>">
          <%= t.type=='CREDIT' ? '+' : '-' %> ₹<%= t.amount %>
        </span>
      </li>
    <% }) %>
  </ul>
</body>
</html>